#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: roundtable <command> [args...]"
  echo ""
  echo "WireGuard networking:"
  printf "  %-42s %s\n" "wg init [--force]" "Initialize host WireGuard mesh"
  printf "  %-42s %s\n" "wg up|down" "Bring host wg0 up/down"
  printf "  %-42s %s\n" "wg peer new [--type agent|foreign] <name>" "Create WireGuard peer + print config. Foreign: optional SSH."
  printf "  %-42s %s\n" "wg peer list" "List all peers (agents + foreign + hosts)"
  printf "  %-42s %s\n" "wg peer config [--type agent|foreign|host] <name>" "Print peer WireGuard config (default: foreign)"
  printf "  %-42s %s\n" "wg peer rm [--type agent|foreign|host] <name>" "Remove WireGuard peer (default: foreign)"
  printf "  %-42s %s\n" "wg peer ssh new [--type foreign] <name>" "Generate SSH key for foreign peer"
  printf "  %-42s %s\n" "wg peer ssh rm [--type foreign] <name>" "Remove SSH key for foreign peer"
  printf "  %-42s %s\n" "wg peer ssh config [--type foreign] <name>" "Print SSH connection info"
  printf "  %-42s %s\n" "wg invite" "Generate anonymous cluster invitation"
  printf "  %-42s %s\n" "wg join <name> <invite-file>" "Connect to a remote mesh"
  printf "  %-42s %s\n" "wg leave <name>" "Disconnect from a remote mesh"
  printf "  %-42s %s\n" "wg restore" "Sync config + routes from saved records (post-upgrade)"
  echo ""
  echo "Agents:"
  printf "  %-42s %s\n" "golden-image build <version>" "Build golden image"
  printf "  %-42s %s\n" "golden-image rebuild <version>" "Rebuild golden image"
  printf "  %-42s %s\n" "agent list" "List agents with Hermes version and upgrade status"
  printf "  %-42s %s\n" "agent create <name> [--cpu N] [--memory SIZE]" "Create agent"
  printf "  %-42s %s\n" "agent start|stop|restart|shell <name>" "Agent lifecycle"
  printf "  %-42s %s\n" "agent logs <name>" "Follow agent journal"
  printf "  %-42s %s\n" "agent setup <name>" "Run hermes setup"
  printf "  %-42s %s\n" "agent gateway up|down <name>" "Start/stop the Hermes gateway"
  printf "  %-42s %s\n" "agent upgrade [--version TAG|BRANCH] [--all|<name>]" "Upgrade Hermes in one or all agents"
  printf "  %-42s %s\n" "agent snapshot create|list|restore|delete <name> [<snap>]" "Manage container snapshots"
  printf "  %-42s %s\n" "agent export <name> [--output DIR]" "Export agent to a portable archive"
  printf "  %-42s %s\n" "agent import <name> <archive>" "Import agent from an archive"
  printf "  %-42s %s\n" "agent delete <name>" "Destroy agent + remove peer"
  printf "  %-42s %s\n" "agent resize <name> [--cpu N] [--memory SIZE]" "Resize agent CPU/memory limits"
  echo ""
  echo "Proxy (port forwarding):"
  printf "  %-42s %s\n" "proxy enable [--public] <port>[:<cport>] <agent>" "Forward host:<port> to agent:<cport> (default: same port)"
  printf "  %-42s %s\n" "proxy disable <port>[:<cport>] <agent>" "Remove a proxy forwarding rule"
  printf "  %-42s %s\n" "proxy list" "List all proxy forwardings and their status"
  echo ""
  echo "Host:"
  printf "  %-42s %s\n" "mcp start|stop|restart|status [--bind IP] [--port PORT]" "Manage the MCP server daemon"
  printf "  %-42s %s\n" "mcp install <name> [--allow \"p1,p2\"]" "Grant agent MCP access + create API key"
  printf "  %-42s %s\n" "mcp uninstall <name>" "Revoke all MCP access for an agent"
  printf "  %-42s %s\n" "mcp grant <name> \"perm1,perm2\"" "Add permission patterns to an agent"
  printf "  %-42s %s\n" "mcp revoke <name> \"p1,p2\"|--all" "Remove permission patterns"
  printf "  %-42s %s\n" "mcp permissions <name>" "Show agent permissions and API key"
  printf "  %-42s %s\n" "mcp list" "List all authorized agents and server status"
  printf "  %-42s %s\n" "status" "Show roundtable version and repository info"
  printf "  %-42s %s\n" "upgrade [--version TAG|unstable|main]" "Upgrade roundtable to latest or a specific version"
  printf "  %-42s %s\n" "upgrade list" "List all available versions"
  printf "  %-42s %s\n" "check [--fix]" "Check host readiness (auto-fix with --fix)"
  exit 0
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROUNDTABLE_DIR="${ROOT}/.roundtable"
CONFIG="${ROOT}/config.yml"
IP_POOL="${ROUNDTABLE_DIR}/ip-pool"
FOREIGN_IP_POOL="${ROUNDTABLE_DIR}/foreign-ip-pool"
PEERS_DIR="${ROUNDTABLE_DIR}/peers"
VOLUMES_DIR="${ROUNDTABLE_DIR}/volumes"
PROXIES_DIR="${ROUNDTABLE_DIR}/proxies"
API_KEYS_DIR="${ROUNDTABLE_DIR}/mcp/api-keys"
PERMISSIONS_DIR="${ROUNDTABLE_DIR}/mcp/permissions"
CLUSTER_SUBNETS_FILE="${ROUNDTABLE_DIR}/cluster-subnets"

ROUNDTABLE_VERSION="$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo 'unknown')"
ROUNDTABLE_BRANCH="$(git -C "$ROOT" rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"

# ── Privilege escalation ──────────────────────────────────────────
# These commands always need root (or LXD socket access). When running
# as non-root we transparently wrap them with sudo. This lets the
# roundtable user (who has passwordless sudo) run commands without
# needing to prefix everything with 'sudo'.
# Note: wg-quick cannot be overridden as a function (hyphen in name),
# so it gets explicit sudo at each call site.
if [[ $EUID -ne 0 ]]; then
  lxc()       { command sudo lxc "$@"; }
  wg()        { command sudo wg "$@"; }
  iptables()  { command sudo iptables "$@"; }
  systemctl() { command sudo systemctl "$@"; }
fi

# ── Config helpers ───────────────────────────────────────────────

yq_required() {
  command -v yq &>/dev/null && return 0
  echo "Error: yq (mikefarah/yq) not found." >&2
  echo "  Install: sudo ./roundtable check --fix" >&2
  exit 1
}

load_config() {
  yq_required
  [[ -f "$CONFIG" ]] || {
    echo "Error: ${CONFIG} not found." >&2
    echo "  Copy config.example.yml to config.yml and fill in your values." >&2
    exit 1
  }

  WG_HOST=$(yq '.network.host // ""' "$CONFIG")
  WG_INTERFACE=$(yq '.network.wg.interface // "wg0"' "$CONFIG")
  WG_PORT=$(yq '.network.wg.port // 51820' "$CONFIG")
  CLUSTER_SUBNET=$(yq '.network.wg.subnets.cluster // "10.0.0.0/8"' "$CONFIG")
  AGENTS_SUBNET=$(yq '.network.wg.subnets.agents // "10.0.1.0/24"' "$CONFIG")
  FOREIGN_SUBNET=$(yq '.network.wg.subnets.foreign // "10.0.2.0/24"' "$CONFIG")
  PERSISTENT_KEEPALIVE=$(yq '.network.wg.opts.persistent_keepalive // 25' "$CONFIG")
  AGENT_CPU=$(yq '.agents.limits.cpu // 1' "$CONFIG")
  AGENT_MEMORY=$(yq '.agents.limits.memory // "768MB"' "$CONFIG")
  UBUNTU_IMAGE=$(yq '."golden-image".base // "ubuntu:24.04"' "$CONFIG")
}

# ── State directory helpers ──────────────────────────────────────

init_state_dir() {
  mkdir -p "$PEERS_DIR" "$VOLUMES_DIR" "$PROXIES_DIR" "$API_KEYS_DIR" "$PERMISSIONS_DIR"

  if [[ ! -f "$IP_POOL" ]]; then
    local base_ip
    base_ip=$(echo "$AGENTS_SUBNET" | cut -d. -f1-3)
    {
      echo "# Auto-generated. Do not edit manually."
      echo "# Available IPs (uncommented) above allocated IPs (prefixed with #)."
      for i in $(seq 2 254); do
        echo "${base_ip}.${i}"
      done
    } > "$IP_POOL"
  fi

  if [[ ! -f "$FOREIGN_IP_POOL" ]]; then
    local foreign_base
    foreign_base=$(echo "$FOREIGN_SUBNET" | cut -d. -f1-3)
    {
      echo "# Auto-generated. Do not edit manually."
      echo "# Available IPs (uncommented) above allocated IPs (prefixed with #)."
      for i in $(seq 2 254); do
        echo "${foreign_base}.${i}"
      done
    } > "$FOREIGN_IP_POOL"
  fi

  touch "$CLUSTER_SUBNETS_FILE"
}

ip_pool_allocate() {
  local pool_file="$1"
  local line_num ip
  line_num=$(grep -n -v '^#' "$pool_file" 2>/dev/null | head -1 | cut -d: -f1)
  if [[ -z "$line_num" ]]; then
    echo "Error: no available IPs in pool (${pool_file})" >&2
    exit 1
  fi
  ip=$(sed -n "${line_num}p" "$pool_file")
  sed -i "${line_num}s/^/#/" "$pool_file"
  echo "$ip"
}

ip_pool_free() {
  local pool_file="$1" ip="$2"
  sed -i "s/^#${ip}$/${ip}/" "$pool_file"
}

peer_record_path() { local name="$1" type="$2"; echo "${PEERS_DIR}/${name}.${type}.yml"; }

peer_config_path() { local name="$1" type="$2"; echo "${PEERS_DIR}/${name}.${type}.conf"; }

peer_record_create() {
  local name="$1" type="$2" record_path
  record_path=$(peer_record_path "$name" "$type")
  cat > "$record_path"
}

peer_record_read_value() {
  local name="$1" type="$2" key="$3"
  local record_path; record_path=$(peer_record_path "$name" "$type")
  [[ -f "$record_path" ]] || { echo "Error: ${type} peer '${name}' not found" >&2; exit 1; }
  yq ".${key} // \"\"" "$record_path"
}

peer_record_delete() { local name="$1" type="$2"; rm -f "$(peer_record_path "$name" "$type")"; }

subnet_in_list() {
  local subnet="$1"
  [[ -f "$CLUSTER_SUBNETS_FILE" ]] && grep -qxF "$subnet" "$CLUSTER_SUBNETS_FILE" 2>/dev/null
}

subnet_list_add() { echo "$1" >> "$CLUSTER_SUBNETS_FILE"; }

subnet_list_remove() {
  local subnet="$1"
  if [[ -f "$CLUSTER_SUBNETS_FILE" ]]; then
    grep -vxF "$subnet" "$CLUSTER_SUBNETS_FILE" > "${CLUSTER_SUBNETS_FILE}.tmp" || true
    mv "${CLUSTER_SUBNETS_FILE}.tmp" "$CLUSTER_SUBNETS_FILE"
    # Clean up empty file — no subnets left
    if [[ ! -s "$CLUSTER_SUBNETS_FILE" ]]; then
      rm -f "$CLUSTER_SUBNETS_FILE"
    fi
  fi
}

# ── WireGuard helpers ────────────────────────────────────────────

wg_ensure_installed() {
  command -v wg &>/dev/null || {
    echo "Error: wireguard-tools not installed. Run: sudo ./roundtable check --fix" >&2
    exit 1
  }
}

wg_ensure_interface() {
  if ! ip link show "$WG_INTERFACE" &>/dev/null; then
    echo "Error: ${WG_INTERFACE} does not exist. Run: roundtable wg init" >&2
    exit 1
  fi
}

wg_add_peer() {
  local pubkey="$1" allowed_ips="$2" endpoint="$3" keepalive="${4:-25}"
  wg set "$WG_INTERFACE" peer "$pubkey" allowed-ips "$allowed_ips" endpoint "$endpoint" persistent-keepalive "$keepalive"
}

wg_remove_peer() {
  local pubkey="$1"
  wg set "$WG_INTERFACE" peer "$pubkey" remove 2>/dev/null || true
}

wg_get_own_pubkey() {
  if sudo test -f /etc/wireguard/publickey 2>/dev/null; then
    sudo cat /etc/wireguard/publickey
  elif sudo test -f "/etc/wireguard/${WG_INTERFACE}.conf" 2>/dev/null; then
    sudo grep -oP 'PrivateKey = \K.*' "/etc/wireguard/${WG_INTERFACE}.conf" | wg pubkey 2>/dev/null || true
  else
    echo ""
  fi
}

# Persist a peer section in the wg-quick config so routes are restored on boot.
# wg-quick up reads [Peer] sections and installs ip route for each AllowedIPs.
wg_config_add_peer() {
  local name="$1" type="$2" pubkey="$3" allowed_ips="$4" endpoint="$5" keepalive="${6:-25}"
  local conf="/etc/wireguard/${WG_INTERFACE}.conf"
  cat >> "$conf" <<PEERSECTION

# peer:${name}:${type}
[Peer]
PublicKey = ${pubkey}
AllowedIPs = ${allowed_ips}
Endpoint = ${endpoint}
PersistentKeepalive = ${keepalive}
PEERSECTION
}

# Remove a persisted peer section from the wg-quick config.
wg_config_remove_peer() {
  local name="$1" type="$2"
  local conf="/etc/wireguard/${WG_INTERFACE}.conf"
  sed -i "/^# peer:${name}:${type}$/,+5d" "$conf" 2>/dev/null || true
}

# ── SSH access helpers ────────────────────────────────────────────
# Foreign (admin/laptop) peers get SSH access as the 'roundtable' user,
# restricted to the WireGuard mesh subnet via an sshd Match block.
# The WG crypto keypair is the only auth needed — no passwords.

SSH_USER="roundtable"
SSH_HOME="/home/${SSH_USER}"
SSH_AUTH_KEYS="${SSH_HOME}/.ssh/authorized_keys"
SSHD_MATCH_CONF="/etc/ssh/sshd_config.d/99-roundtable.conf"

ssh_ensure_user() {
  # Create the roundtable user if missing (idempotent)
  if ! id "$SSH_USER" &>/dev/null; then
    echo "  SSH: creating '${SSH_USER}' user..." >&2
    useradd -m -s /bin/bash "$SSH_USER"
    passwd -l "$SSH_USER" &>/dev/null || true
    echo "${SSH_USER} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/99-${SSH_USER}"
    chmod 440 "/etc/sudoers.d/99-${SSH_USER}"
  fi

  # Ensure .ssh directory with correct permissions
  mkdir -p "${SSH_HOME}/.ssh"
  chmod 700 "${SSH_HOME}/.ssh"

  # Ensure authorized_keys exists
  touch "$SSH_AUTH_KEYS"
  chmod 600 "$SSH_AUTH_KEYS"
  chown -R "${SSH_USER}:${SSH_USER}" "$SSH_HOME"

  # Install sshd Match block if not already present
  if [[ ! -f "$SSHD_MATCH_CONF" ]]; then
    echo "  SSH: installing sshd Match block (restrict to 10.0.0.0/8)..." >&2
    cat > "$SSHD_MATCH_CONF" <<SSHDCONF
# Managed by roundtable — restricts SSH access for the '${SSH_USER}' user
# to the WireGuard mesh subnet. Does not affect other users.
Match User ${SSH_USER} Address 10.0.0.0/8
    PubkeyAuthentication yes
    PasswordAuthentication no
SSHDCONF
    chmod 644 "$SSHD_MATCH_CONF"
    # Reload sshd to pick up the new config
    if systemctl is-active sshd &>/dev/null; then
      systemctl reload sshd 2>/dev/null || true
    elif systemctl is-active ssh &>/dev/null; then
      systemctl reload ssh 2>/dev/null || true
    fi
  fi
}

ssh_install_key() {
  local name="$1" pubkey="$2"
  # Add a marker + key pair so we can remove it by peer name later
  echo "# peer:${name}" >> "$SSH_AUTH_KEYS"
  echo "${pubkey}" >> "$SSH_AUTH_KEYS"
}

ssh_remove_key() {
  local name="$1"
  # Remove the marker line and the key line that follows
  sed -i "/^# peer:${name}$/,+1d" "$SSH_AUTH_KEYS" 2>/dev/null || true
}

ssh_access_is_setup() {
  [[ -L "${SSH_HOME}/cli-roundtable" ]] && \
    [[ "$(readlink -f "${SSH_HOME}/cli-roundtable")" == "$(readlink -f "$ROOT")" ]] && \
    getfacl /root 2>/dev/null | grep -q "user:roundtable:r-x"
}

ssh_ensure_access() {
  echo "  SSH: Setting up roundtable user workspace..." >&2

  # Install ACL package if needed
  if ! command -v setfacl &>/dev/null; then
    echo "  SSH: Installing acl package..." >&2
    sudo apt-get install -y acl -qq 2>/dev/null || true
  fi

  # Symlink project dir into roundtable home
  echo "  SSH: Linking ${ROOT} → ${SSH_HOME}/cli-roundtable" >&2
  ln -sf "$ROOT" "${SSH_HOME}/cli-roundtable"

  # PATH entry in .bashrc
  local bashrc="${SSH_HOME}/.bashrc"
  if ! grep -q "cli-roundtable" "$bashrc" 2>/dev/null; then
    echo "  SSH: Adding ${ROOT} to roundtable user PATH" >&2
    echo "export PATH=\"\$PATH:${ROOT}\"" >> "$bashrc"
  fi

  # ACL permissions for read/write access
  echo "  SSH: Setting ACL permissions on ${ROOT} for roundtable user" >&2
  sudo setfacl -R -m u:roundtable:rwX "$ROOT"
  sudo setfacl -R -d -m u:roundtable:rwX "$ROOT" 2>/dev/null || true

  # Allow traverse into /root so the roundtable user can follow the symlink
  if ! getfacl /root 2>/dev/null | grep -q "user:roundtable:r-x"; then
    echo "  SSH: Granting traverse on /root for roundtable user" >&2
    sudo setfacl -m u:roundtable:rx /root
  fi

  echo "  ✅ SSH user workspace configured. Log in as 'roundtable' and run: roundtable check" >&2
}

# ── Command implementations ──────────────────────────────────────

cmd_wg() {
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    up)     cmd_wg_up ;;
    down)   cmd_wg_down ;;
    init)   cmd_wg_init "$@" ;;
    peer)   cmd_wg_peer "$@" ;;
    invite) cmd_wg_invite ;;
    join)   cmd_wg_join "$@" ;;
    leave)  cmd_wg_leave "$@" ;;
    restore) cmd_wg_restore ;;
    *)      usage ;;
  esac
}

cmd_wg_init() {
  local force=false
  [[ "${1:-}" == "--force" ]] && force=true

  load_config
  wg_ensure_installed

  # Check if already initialized
  if ip link show "$WG_INTERFACE" &>/dev/null; then
    if $force; then
      echo "==> Tearing down existing ${WG_INTERFACE} (--force)..." >&2
      sudo wg-quick down "$WG_INTERFACE" 2>/dev/null || true
      sudo systemctl disable "wg-quick@${WG_INTERFACE}" 2>/dev/null || true
    else
      echo "${WG_INTERFACE} already exists. Use --force to re-initialize." >&2
      return 0
    fi
  fi

  [[ -n "$WG_HOST" ]] || { echo "Error: network.host not set in config" >&2; exit 1; }

  local host_ip
  host_ip=$(echo "$AGENTS_SUBNET" | sed 's|0/24$|1/24|' | sed 's|/24$||')
  # host_ip is now the bare IP (e.g. 10.0.1.1) without CIDR suffix

  echo "==> Initializing host WireGuard mesh..." >&2
  echo "    Interface: ${WG_INTERFACE}" >&2
  echo "    Mesh IP:   ${host_ip}/24 (${AGENTS_SUBNET})" >&2
  echo "    Port:      ${WG_PORT}" >&2
  echo "    Host:      ${WG_HOST}" >&2

  # Generate keys if missing
  if [[ ! -f /etc/wireguard/privatekey ]] || [[ ! -f /etc/wireguard/publickey ]]; then
    echo "==> Generating host WireGuard keypair..." >&2
    umask 077
    wg genkey | tee /etc/wireguard/privatekey | wg pubkey > /etc/wireguard/publickey
    umask 022
  fi

  # Write wg config
  local wg_conf="/etc/wireguard/${WG_INTERFACE}.conf"
  cat > "$wg_conf" <<WGCONF
[Interface]
Address = ${host_ip}
PrivateKey = $(cat /etc/wireguard/privatekey)
ListenPort = ${WG_PORT}
SaveConfig = false

# Agents, foreign peers, and cluster peers are persisted below by
# 'roundtable wg peer' / 'roundtable wg join' for reboot resilience.
WGCONF

  # Enable IP forwarding
  sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
  if ! grep -q 'net.ipv4.ip_forward=1' /etc/sysctl.d/99-roundtable.conf 2>/dev/null; then
    echo 'net.ipv4.ip_forward=1' > /etc/sysctl.d/99-roundtable.conf
  fi

  # Init state directory
  init_state_dir

  # Check for port conflict before bringing up wg0
  if ss -tulpn | grep -q ":${WG_PORT} "; then
    local conflict
    conflict=$(ss -tulpn "sport = :${WG_PORT}" 2>/dev/null | grep -v "wg0" | head -1)
    echo "⚠️  Port ${WG_PORT}/udp is already in use:" >&2
    echo "    ${conflict}" >&2
    echo "    Run 'docker stop cli-roundtable-wg-easy-1' if it's a leftover wg-easy container." >&2
    echo "    Or set a different port in config.yml (network.wg.port)." >&2
    exit 1
  fi

  echo "==> Bringing up ${WG_INTERFACE}..." >&2
  sudo wg-quick up "$WG_INTERFACE" || { echo "Failed to bring up ${WG_INTERFACE}." >&2; exit 1; }

  # Enable persistent via systemd
  systemctl enable "wg-quick@${WG_INTERFACE}" 2>/dev/null || true

  echo "==> Host WireGuard mesh initialized." >&2
  echo "    Interface: ${WG_INTERFACE}" >&2
  echo "    Mesh IP:   ${host_ip} (${AGENTS_SUBNET})" >&2
  echo "    Listen:    ${WG_PORT}/udp" >&2
  echo "    Service:   wg-quick@${WG_INTERFACE} (enabled)" >&2
  echo "    State:     ${ROUNDTABLE_DIR}" >&2
}

cmd_wg_up() {
  load_config
  wg_ensure_installed
  sudo wg-quick up "$WG_INTERFACE" 2>/dev/null || { echo "${WG_INTERFACE} not configured. Run: roundtable wg init" >&2; exit 1; }
  echo "${WG_INTERFACE} is up." >&2
}

cmd_wg_down() {
  load_config
  sudo wg-quick down "$WG_INTERFACE" 2>/dev/null || true
  echo "${WG_INTERFACE} is down." >&2
}

cmd_wg_peer() {
  local action="${1:-}"; shift 2>/dev/null || true
  case "$action" in
    new)    cmd_wg_peer_new "$@" ;;
    list)   cmd_wg_peer_list ;;
    config) cmd_wg_peer_config "$@" ;;
    rm)     cmd_wg_peer_rm "$@" ;;
    ssh)    cmd_wg_peer_ssh "$@" ;;
    *)      usage ;;
  esac
}

cmd_wg_peer_new() {
  local name="" peer_type="foreign"

  # Parse args: --type agent|foreign (default: foreign), positional name
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type)
        peer_type="${2:-foreign}"
        shift 2
        ;;
      --type=*)
        peer_type="${1#*=}"
        shift
        ;;
      -*)
        echo "Error: unknown flag $1" >&2
        exit 1
        ;;
      *)
        name="$1"
        shift
        ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable wg peer new [--type agent|foreign] <name>" >&2; exit 1; }
  [[ "$peer_type" =~ ^(agent|foreign)$ ]] || { echo "Error: --type must be 'agent' or 'foreign'" >&2; exit 1; }

  load_config
  wg_ensure_interface

  init_state_dir

  # Check if peer already exists
  local record_path; record_path=$(peer_record_path "$name" "$peer_type")
  if [[ -f "$record_path" ]]; then
    echo "Peer '${name}' already exists:" >&2
    cmd_wg_peer_config "$name"
    return
  fi

  # Pick pool based on type
  local pool_file
  if [[ "$peer_type" == "foreign" ]]; then
    pool_file="$FOREIGN_IP_POOL"
  else
    pool_file="$IP_POOL"
  fi

  # Allocate IP from correct pool
  local peer_ip
  peer_ip=$(ip_pool_allocate "$pool_file")
  echo "    IP: ${peer_ip} (${peer_type})" >&2

  # Generate keypair
  local peer_privkey peer_pubkey
  peer_privkey=$(wg genkey)
  peer_pubkey=$(echo "$peer_privkey" | wg pubkey)

  # Read host's public key
  local host_pubkey
  host_pubkey=$(wg_get_own_pubkey)
  [[ -n "$host_pubkey" ]] || { echo "Error: could not read host public key" >&2; exit 1; }

  # Host mesh IP (from agents subnet, always)
  local host_ip
  host_ip=$(echo "$AGENTS_SUBNET" | sed 's|0/24$|1/24|' | sed 's|/24$||')

  # Add peer to host wg0
  wg_add_peer "$peer_pubkey" "${peer_ip}/32" "${host_ip}:${WG_PORT}"

  # Install route immediately so the kernel routes peer IP through wg0
  ip route replace "${peer_ip}/32" dev "$WG_INTERFACE" 2>/dev/null || true

  # Persist peer record (YAML)
  {
    echo "name: ${name}"
    echo "ip: ${peer_ip}"
    echo "public_key: ${peer_pubkey}"
    echo "type: ${peer_type}"
    echo "created: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$record_path"

  # Persist peer section in wg-quick config for route restoration on boot
  wg_config_add_peer "$name" "$peer_type" "$peer_pubkey" "${peer_ip}/32" "${WG_HOST}:${WG_PORT}"

  if [[ "$peer_type" == "agent" ]]; then
    # ── Agent config: save to .roundtable/peers/<name>.agent.conf ──
    local agent_conf_path; agent_conf_path=$(peer_config_path "$name" "agent")
    cat > "$agent_conf_path" <<WGOCONF
[Interface]
Address = ${peer_ip}/32
PrivateKey = ${peer_privkey}
# No DNS — LXD containers use systemd-resolved (stub at 127.0.0.53).
# wg-quick overwriting resolv.conf breaks DNS.
# Route the WireGuard endpoint IP via eth0 to prevent routing loops
PostUp = ip route add ${host_ip}/32 dev eth0 2>/dev/null || true
# Keep LXD bridge traffic out of wg0 (CLUSTER_SUBNET covers it)
PostUp = for s in $(ip -4 addr show eth0 | grep -oP 'inet \K[\d.]+/\d+'); do ip route add "$s" dev eth0 metric 99 2>/dev/null; done || true

[Peer]
PublicKey = ${host_pubkey}
AllowedIPs = ${CLUSTER_SUBNET}
Endpoint = ${host_ip}:${WG_PORT}
PersistentKeepalive = ${PERSISTENT_KEEPALIVE}
WGOCONF
  else
    # ── Foreign/laptop config: clean WireGuard config ──
    local foreign_conf_path; foreign_conf_path=$(peer_config_path "$name" "foreign")
    cat > "$foreign_conf_path" <<FOREIGN_CONFIG
[Interface]
Address = ${peer_ip}/32
PrivateKey = ${peer_privkey}
DNS = 1.1.1.1

[Peer]
PublicKey = ${host_pubkey}
AllowedIPs = ${CLUSTER_SUBNET}
Endpoint = ${WG_HOST}:${WG_PORT}
PersistentKeepalive = ${PERSISTENT_KEEPALIVE}
FOREIGN_CONFIG
    cat "$foreign_conf_path"
    echo "" >&2

    # ── Optional SSH access for foreign peers ──
    if [[ -t 0 ]]; then
      # Interactive terminal — ask
      echo "  SSH access (optional):" >&2
      read -p "  Generate SSH key for admin access? [y/N] " -r response
      echo "" >&2
    else
      response=""
    fi
    if [[ "$response" =~ ^[Yy]$ ]]; then
      cmd_wg_peer_ssh_new "$name" 2>&1
    fi
  fi
}

cmd_wg_peer_config() {
  local name="" peer_type="foreign"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type) peer_type="${2:-foreign}"; shift 2 ;;
      --type=*) peer_type="${1#*=}"; shift ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable wg peer config [--type agent|foreign|host] <name>" >&2; exit 1; }

  load_config
  wg_ensure_interface

  local record_path; record_path=$(peer_record_path "$name" "$peer_type")
  [[ -f "$record_path" ]] || { echo "Error: ${peer_type} peer '${name}' not found" >&2; exit 1; }

  if [[ "$peer_type" == "host" ]]; then
    local peer_subnet peer_endpoint peer_pubkey
    peer_subnet=$(yq '.subnets.agents // ""' "$record_path")
    peer_endpoint=$(yq '.endpoint // ""' "$record_path")
    peer_pubkey=$(yq '.public_key // ""' "$record_path")
    echo "# Cluster peer: ${name}"
    echo "# Subnets:     ${peer_subnet}"
    echo "# Endpoint:    ${peer_endpoint}"
    wg show "$WG_INTERFACE" | grep -A2 "peer: ${peer_pubkey}" 2>/dev/null || echo "(peer not currently connected)"
  elif [[ "$peer_type" == "agent" ]]; then
    local agent_conf_path; agent_conf_path=$(peer_config_path "$name" "agent")
    if [[ -f "$agent_conf_path" ]]; then
      cat "$agent_conf_path"
    else
      echo "Error: no config saved for agent '${name}'" >&2
      exit 1
    fi
  elif [[ "$peer_type" == "foreign" ]]; then
    local foreign_conf_path; foreign_conf_path=$(peer_config_path "$name" "foreign")
    if [[ -f "$foreign_conf_path" ]]; then
      cat "$foreign_conf_path"
    else
      echo "Error: no config saved for foreign peer '${name}'" >&2
      exit 1
    fi
  else
    echo "Error: unknown peer type '${peer_type}' for '${name}'" >&2
    exit 1
  fi
}

cmd_wg_peer_rm() {
  local name="" peer_type="foreign"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type) peer_type="${2:-foreign}"; shift 2 ;;
      --type=*) peer_type="${1#*=}"; shift ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable wg peer rm [--type agent|foreign|host] <name>" >&2; exit 1; }

  load_config
  wg_ensure_interface

  local record_path; record_path=$(peer_record_path "$name" "$peer_type")
  [[ -f "$record_path" ]] || { echo "Error: ${peer_type} peer '${name}' not found" >&2; exit 1; }

  local peer_pubkey peer_ip
  peer_pubkey=$(yq '.public_key // ""' "$record_path")
  peer_ip=$(yq '.ip // ""' "$record_path")

  echo "==> Removing WireGuard peer '${name}' (${peer_type})..." >&2

  wg_remove_peer "$peer_pubkey"

  # Remove peer section from wg-quick config
  wg_config_remove_peer "$name" "$peer_type"

  # Remove the route for this peer
  if [[ -n "$peer_ip" ]]; then
    ip route del "${peer_ip}/32" dev "$WG_INTERFACE" 2>/dev/null || true
  fi

  # Free IP from the correct pool
  local pool_file
  if [[ "$peer_type" == "agent" ]]; then
    pool_file="$IP_POOL"
  elif [[ "$peer_type" == "foreign" ]]; then
    pool_file="$FOREIGN_IP_POOL"
  fi

  if [[ -n "${pool_file:-}" && -n "$peer_ip" ]]; then
    ip_pool_free "$pool_file" "$peer_ip"
    echo "    IP ${peer_ip} freed" >&2
  fi

  peer_record_delete "$name" "$peer_type"

  # Clean up saved config if it exists
  local conf_path; conf_path=$(peer_config_path "$name" "$peer_type" 2>/dev/null || echo "")
  if [[ -n "$conf_path" && -f "$conf_path" ]]; then
    rm -f "$conf_path"
  fi

  # Clean up SSH key for foreign peers
  if [[ "$peer_type" == "foreign" ]]; then
    ssh_remove_key "$name"
    local ssh_key_path; ssh_key_path=$(peer_config_path "$name" "foreign" | sed 's/\.conf$/.ssh-key/')
    rm -f "$ssh_key_path" "${ssh_key_path}.pub" 2>/dev/null || true
  fi

  echo "    Peer removed." >&2
}

# ── SSH key management ────────────────────────────────────────
# Manage SSH keys for foreign peers independently of peer creation.
# Usage: roundtable wg peer ssh new|rm|config [--type agent|foreign|host] <name>

cmd_wg_peer_ssh() {
  local action="${1:-}"; shift 2>/dev/null || true
  case "$action" in
    new)    cmd_wg_peer_ssh_new "$@" ;;
    rm)     cmd_wg_peer_ssh_rm "$@" ;;
    config) cmd_wg_peer_ssh_config "$@" ;;
    *)      echo "Usage: roundtable wg peer ssh new|rm|config [--type agent|foreign|host] <name>" >&2; exit 1 ;;
  esac
}

cmd_wg_peer_ssh_new() {
  local name="" peer_type="foreign"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type) peer_type="${2:-foreign}"; shift 2 ;;
      --type=*) peer_type="${1#*=}"; shift ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable wg peer ssh new [--type agent|foreign|host] <name>" >&2; exit 1; }
  [[ "$peer_type" == "foreign" ]] || { echo "Error: SSH keys only supported for 'foreign' peers, not '${peer_type}'" >&2; exit 1; }

  load_config

  local record_path; record_path=$(peer_record_path "$name" "foreign")
  [[ -f "$record_path" ]] || { echo "Error: foreign peer '${name}' not found" >&2; exit 1; }

  local host_ip
  host_ip=$(echo "$AGENTS_SUBNET" | sed 's|0/24$|1/24|' | sed 's|/24$||')

  ssh_ensure_user
  local ssh_key_path; ssh_key_path=$(peer_config_path "$name" "foreign" | sed 's/\.conf$/.ssh-key/')

  if [[ -f "$ssh_key_path" ]]; then
    echo "    SSH key already exists for '${name}': ssh ${SSH_USER}@${host_ip} -i ${ssh_key_path}" >&2
    return
  fi

  ssh-keygen -t ed25519 -f "$ssh_key_path" -N "" -C "roundtable:${name}" -q 2>/dev/null
  ssh_install_key "$name" "$(cat "${ssh_key_path}.pub")"

  # Prompt for workspace setup if not already configured
  if ! ssh_access_is_setup; then
    echo "" >&2
    read -p "  Set up roundtable user workspace (symlink, PATH, permissions)? [y/N] " response
    if [[ "$response" =~ ^[Yy]$ ]]; then
      ssh_ensure_access
    fi
  fi

  echo "    SSH key generated for '${name}': ssh ${SSH_USER}@${host_ip} -i ${ssh_key_path}" >&2
}

cmd_wg_peer_ssh_rm() {
  local name="" peer_type="foreign"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type) peer_type="${2:-foreign}"; shift 2 ;;
      --type=*) peer_type="${1#*=}"; shift ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable wg peer ssh rm [--type agent|foreign|host] <name>" >&2; exit 1; }
  [[ "$peer_type" == "foreign" ]] || { echo "Error: SSH keys only supported for 'foreign' peers, not '${peer_type}'" >&2; exit 1; }

  load_config

  local ssh_key_path; ssh_key_path=$(peer_config_path "$name" "foreign" | sed 's/\.conf$/.ssh-key/')
  if [[ ! -f "$ssh_key_path" ]]; then
    echo "    No SSH key found for '${name}'." >&2
    return
  fi

  ssh_remove_key "$name"
  rm -f "$ssh_key_path" "${ssh_key_path}.pub" 2>/dev/null || true
  echo "    SSH key removed for '${name}'." >&2
}

cmd_wg_peer_ssh_config() {
  local name="" peer_type="foreign"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type) peer_type="${2:-foreign}"; shift 2 ;;
      --type=*) peer_type="${1#*=}"; shift ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable wg peer ssh config [--type agent|foreign|host] <name>" >&2; exit 1; }
  [[ "$peer_type" == "foreign" ]] || { echo "Error: SSH keys only supported for 'foreign' peers, not '${peer_type}'" >&2; exit 1; }

  load_config

  local record_path; record_path=$(peer_record_path "$name" "foreign")
  [[ -f "$record_path" ]] || { echo "Error: foreign peer '${name}' not found" >&2; exit 1; }

  local host_ip
  host_ip=$(echo "$AGENTS_SUBNET" | sed 's|0/24$|1/24|' | sed 's|/24$||')
