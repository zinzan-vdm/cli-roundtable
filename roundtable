#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: roundtable <command> [args...]"
  echo ""
  echo "Commands:"
  printf "  %-42s %s\n" "wg up|down|logs" "Manage wg-easy VPN"
  printf "  %-42s %s\n" "wg peer new <name>" "Create WireGuard peer"
  printf "  %-42s %s\n" "wg peer list" "List peers"
  printf "  %-42s %s\n" "wg peer config <name>" "Print peer config"
  printf "  %-42s %s\n" "wg host up|down|ip" "Manage host's WireGuard tunnel"
  printf "  %-42s %s\n" "golden-image build <version>" "Build golden image"
  printf "  %-42s %s\n" "golden-image rebuild <version>" "Rebuild golden image"
  printf "  %-42s %s\n" "agent list" "List agents"
  printf "  %-42s %s\n" "agent create <name>" "Create agent"
  printf "  %-42s %s\n" "agent start|stop|restart|shell <name>" "Agent lifecycle"
  printf "  %-42s %s\n" "agent logs <name>" "Follow agent journal"
  printf "  %-42s %s\n" "agent setup <name>" "Run hermes setup"
  printf "  %-42s %s\n" "agent gateway up|down <name>" "Start/stop the Hermes gateway"
  printf "  %-42s %s\n" "agent delete <name>" "Destroy agent + revoke peer"
  printf "  %-42s %s\n" "check [--fix]" "Check host readiness (auto-fix with --fix)"
  exit 0
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTENV="${ROOT}/.env"
AGENTS_DIR="${ROOT}/.agents"
COMPOSE_FILE="${ROOT}/compose.yml"
COOKIE_JAR=$(mktemp /tmp/roundtable-cookies.XXXXXX)
trap 'rm -f "$COOKIE_JAR"' EXIT

load_env() {
  [[ -f "$DOTENV" ]] && source "$DOTENV"
  WG_PASSWORD="${WG_PASSWORD:-}"
  AGENT_MEMORY="${AGENT_MEMORY:-768MB}"
  AGENT_CPU="${AGENT_CPU:-1}"
  UBUNTU_IMAGE="${UBUNTU_IMAGE:-ubuntu:24.04}"
  WG_TOOLS_VER="${WG_TOOLS_VER:-1.0.20210914-1ubuntu4}"
  CURL_VER="${CURL_VER:-8.5.0-2ubuntu10.9}"
  CA_CERT_VER="${CA_CERT_VER:-20240203}"
  WG_HOST_IP="${WG_HOST_IP:-10.10.0.254}"
  WG_API="http://${WG_HOST_IP}:51821"
  WG_POOL_ADDRESS="${WG_POOL_ADDRESS:-10.10.1.x}"
}

wg_auth() {
  [[ -n "$WG_PASSWORD" ]] || { echo "Error: WG_PASSWORD not set in .env" >&2; exit 1; }
  curl -sf -X POST "${WG_API}/api/session" \
    -H "Content-Type: application/json" \
    -d "{\"password\":\"${WG_PASSWORD}\"}" \
    -c "$COOKIE_JAR" -o /dev/null 2>/dev/null || {
    echo "Error: wg-easy auth failed. Is wg-easy running? (roundtable wg up)" >&2
    exit 1
  }
}

cmd_wg() {
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    up)    docker compose -f "$COMPOSE_FILE" up -d wg-easy ;;
    down)  docker compose -f "$COMPOSE_FILE" down ;;
    logs)  exec docker compose -f "$COMPOSE_FILE" logs -f wg-easy ;;
    peer)  cmd_wg_peer "$@" ;;
    host)  cmd_wg_host "$@" ;;
    *)     usage ;;
  esac
}

cmd_wg_peer() {
  local action="${1:-}"; shift 2>/dev/null || true
  wg_auth
  case "$action" in
    new)
      local name="${1:?Usage: roundtable wg peer new <name>}"
      local existing; existing=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client" 2>/dev/null || echo "[]")
      if echo "$existing" | grep -q "\"name\":\"${name}\""; then
        echo "Peer '${name}' already exists:" >&2
        cmd_wg_peer config "$name"
        return
      fi
      echo "Creating peer '${name}'..." >&2
      curl -sf -X POST "${WG_API}/api/wireguard/client" \
        -H "Content-Type: application/json" -b "$COOKIE_JAR" \
        -d "{\"name\":\"${name}\"}" -o /dev/null
      cmd_wg_peer config "$name"
      ;;
    list)
      local peers; peers=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client" 2>/dev/null || echo "[]")
      echo "$peers" | python3 -c "
import json, sys
for p in json.load(sys.stdin):
    e = '+' if p.get('enabled', True) else '-'
    print(f'  {e} {(p.get(\"name\") or \"?\").ljust(20)} {p.get(\"address\") or \"?\"}')" 2>/dev/null || echo "$peers"
      ;;
    config)
      local name="${1:?Usage: roundtable wg peer config <name>}"
      local config; config=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client/${name}/configuration" 2>/dev/null)
      [[ -n "$config" ]] || { echo "Peer '${name}' not found." >&2; exit 1; }
      echo "$config"
      ;;
    *) usage ;;
  esac
}

cmd_wg_host() {
  local action="${1:-}"
  shift 2>/dev/null || true
  local host_peer="host-vps"
  local wg_conf="/etc/wireguard/wg-host.conf"

  case "$action" in
    up)
      command -v wg &>/dev/null || { echo "wireguard-tools not installed. Run: sudo ./roundtable check --fix" >&2; exit 1; }
      wg_auth

      # Create or update the host peer via wg-easy API
      local existing
      existing=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client" 2>/dev/null || echo "[]")
      if ! echo "$existing" | grep -q "\"name\":\"${host_peer}\""; then
        echo "Creating peer '${host_peer}'..." >&2
        curl -sf -X POST "${WG_API}/api/wireguard/client" \
          -H "Content-Type: application/json" -b "$COOKIE_JAR" \
          -d "{\"name\":\"${host_peer}\"}" -o /dev/null
      fi

      # Fetch config by ID
      local all_peers
      all_peers=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client" 2>/dev/null || echo "[]")
      local peer_id
      peer_id=$(echo "$all_peers" | python3 -c "
import json,sys
peers=json.load(sys.stdin)
for p in peers:
    if p.get('name') == '${host_peer}':
        print(p.get('id',''))
        break
" 2>/dev/null || true)

      if [[ -z "$peer_id" ]]; then
        echo "Error: could not find peer '${host_peer}' after creation." >&2
        exit 1
      fi

      local config
      config=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client/${peer_id}/configuration" 2>/dev/null || true)
      if [[ -z "$config" ]]; then
        echo "Error: could not fetch config for '${host_peer}'." >&2
        exit 1
      fi

      echo "$config" > "$wg_conf"
      local host_ip
      host_ip=$(echo "$config" | grep Address | awk '{print $3}' | cut -d/ -f1)
      echo "Host WireGuard interface is up." >&2
      echo "  Mesh IP: ${host_ip}" >&2
      systemctl enable wg-quick@wg-host 2>/dev/null || true
      wg-quick up wg-host 2>/dev/null || { echo "Failed to bring up wg-host." >&2; exit 1; }
      echo "  Config:  ${wg_conf}" >&2
      echo "  Service: wg-quick@wg-host (enabled)" >&2
      ;;
    down)
      echo "Bringing down host WireGuard tunnel..." >&2
      wg-quick down wg-host 2>/dev/null || true
      systemctl disable wg-quick@wg-host 2>/dev/null || true
      echo "Host WireGuard tunnel is down." >&2
      ;;
    ip)
      local host_ip
      host_ip=$(cat "$wg_conf" 2>/dev/null | grep Address | awk '{print $3}' | cut -d/ -f1)
      if [[ -n "$host_ip" ]]; then
        echo "$host_ip"
      else
        echo "Host WireGuard not configured. Run: sudo ./roundtable wg host up" >&2
        exit 1
      fi
      ;;
    *)
      echo "Usage: roundtable wg host up|down|ip" >&2
      return 1
      ;;
  esac
}

cmd_golden_image() {
  local sub="${1:-}"; shift 2>/dev/null || true
  local version="${1:-main}"

  [[ "$sub" =~ ^(build|rebuild)$ ]] || usage

  if [ "$sub" = "rebuild" ]; then
    lxc image alias delete roundtable-agent 2>/dev/null || true
    lxc image delete roundtable-agent 2>/dev/null || true
    lxc image alias delete hermes-agent 2>/dev/null || true
    lxc image delete hermes-agent 2>/dev/null || true
  fi

  if lxc image alias list 2>/dev/null | grep -q roundtable-agent; then
    echo "Golden image already exists. Use 'rebuild' to replace it." >&2
    exit 1
  fi

  echo "==> Building golden image (Hermes ${version})..." >&2
  lxc launch "${UBUNTU_IMAGE}" roundtable-tmp

  # Wait for network (up to 60s)
  echo -n "==> Waiting for network..." >&2
  for i in $(seq 1 60); do
    if lxc exec roundtable-tmp -- ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
      echo " connected." >&2; break
    fi
    echo -n "." >&2; sleep 1
  done

  echo "==> Installing wireguard-tools..." >&2
  lxc exec roundtable-tmp -- apt-get update -qq
  lxc exec roundtable-tmp -- apt-get install -y -qq "wireguard-tools=${WG_TOOLS_VER}" "curl=${CURL_VER}" "ca-certificates=${CA_CERT_VER}"

  echo "==> Installing Hermes Agent (${version})..." >&2
  lxc exec roundtable-tmp -- bash -c "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --non-interactive --skip-setup --branch \"${version}\""

  echo "==> Cleaning up..." >&2
  lxc exec roundtable-tmp -- apt-get clean -qq
  lxc exec roundtable-tmp -- rm -rf /var/lib/apt/lists/*

  echo "==> Publishing image..." >&2
  lxc stop roundtable-tmp
  lxc publish roundtable-tmp --alias roundtable-agent --public=false
  lxc delete roundtable-tmp

  echo "Golden image 'roundtable-agent' (Hermes ${version}) published." >&2
  lxc image list roundtable-agent
}

agent_lxc_name() { echo "roundtable-${1}"; }

cmd_agent() {
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    list)    lxc list -c n,s,4,m "roundtable-" 2>/dev/null || lxc list -c n,s,4,m ;;
    create)  cmd_agent_create "$@" ;;
    start|stop|restart)
      local name="${1:?Usage: roundtable agent $sub <name>}"
      lxc "$sub" "$(agent_lxc_name "$name")" ;;
    shell)   lxc exec "$(agent_lxc_name "${1:?Usage: roundtable agent shell <name>}")" bash ;;
    logs)
      local lxc_name; lxc_name=$(agent_lxc_name "${1:?Usage: roundtable agent logs <name>}")
      lxc exec "$lxc_name" -- journalctl -u "hermes*" -f 2>/dev/null || lxc exec "$lxc_name" -- journalctl -f ;;
    setup)
      lxc exec "$(agent_lxc_name "${1:?Usage: roundtable agent setup <name>}")" -- hermes setup ;;
    gateway) cmd_agent_gateway "$@" ;;
    delete)  cmd_agent_delete "$@" ;;
    *)       usage ;;
  esac
}

cmd_agent_create() {
  local name="${1:?Usage: roundtable agent create <name>}"
  local lxc_name; lxc_name=$(agent_lxc_name "$name")

  if ! lxc image alias list 2>/dev/null | grep -q roundtable-agent; then
    echo "No golden image. Run: roundtable golden-image build <version>" >&2
    exit 1
  fi

  local agent_dir="${AGENTS_DIR}/${name}"
  mkdir -p "${agent_dir}/volume"

  echo "==> Launching agent '${name}' (${lxc_name})..." >&2
  lxc launch roundtable-agent "$lxc_name" \
    -c limits.memory="${AGENT_MEMORY}" \
    -c limits.cpu="${AGENT_CPU}" \
    -c boot.autostart=true

  lxc config device add "$lxc_name" volume disk \
    source="${agent_dir}/volume" path=/opt/data

  sleep 5

  echo "==> Setting up WireGuard peer..." >&2
  local wg_config=""
  wg_auth 2>/dev/null || true
  if [[ -n "$WG_PASSWORD" ]]; then
    local existing
    existing=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client" 2>/dev/null || echo "[]")
    if ! echo "$existing" | grep -q "\"name\":\"${name}\""; then
      curl -sf -X POST "${WG_API}/api/wireguard/client" \
        -H "Content-Type: application/json" -b "$COOKIE_JAR" \
        -d "{\"name\":\"${name}\"}" -o /dev/null 2>/dev/null || true
    fi
    local all_peers
    all_peers=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client" 2>/dev/null || echo "[]")
    local peer_id
    peer_id=$(echo "$all_peers" | python3 -c "
import json,sys
peers=json.load(sys.stdin)
for p in peers:
    if p.get('name') == '$name':
        print(p['id'])
        break
" 2>/dev/null || true)
    if [[ -n "$peer_id" ]]; then
      wg_config=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client/${peer_id}/configuration" 2>/dev/null || true)
    fi
  fi

  if [[ -n "$wg_config" ]]; then
    echo "$wg_config" | lxc exec "$lxc_name" -- tee /etc/wireguard/wg0.conf > /dev/null
    lxc exec "$lxc_name" -- systemctl enable wg-quick@wg0 2>/dev/null || true
    lxc exec "$lxc_name" -- wg-quick up wg0 2>/dev/null || true
  fi

  echo "==> Agent '${name}' ready." >&2
  echo "  Dashboard: http://${WG_POOL_ADDRESS}:9119  (check IP: roundtable wg peer list)" >&2
  echo "  Shell:     roundtable agent shell ${name}" >&2
  echo "  Setup:     roundtable agent setup ${name}" >&2
  lxc list -c n,s,4 "$lxc_name"
}

cmd_agent_gateway() {
  local action="${1:?Usage: roundtable agent gateway up|down <name>}"
  local name="${2:?Usage: roundtable agent gateway up|down <name>}"
  local lxc_name; lxc_name=$(agent_lxc_name "$name")

  case "$action" in
    up)
      echo "==> Installing and starting gateway for '${name}'..." >&2
      lxc exec "$lxc_name" -- bash -c "printf 'Y\nY\n' | hermes gateway --accept-hooks install"
      echo "Gateway started for '${name}'." >&2
      lxc exec "$lxc_name" -- hermes gateway status
      ;;
    down)
      echo "==> Stopping gateway for '${name}'..." >&2
      lxc exec "$lxc_name" -- hermes gateway stop
      echo "Gateway stopped for '${name}'." >&2
      ;;
    *)
      echo "Usage: roundtable agent gateway up|down <name>" >&2
      return 1
      ;;
  esac
}

cmd_agent_delete() {
  local name="${1:?Usage: roundtable agent delete <name>}"
  local lxc_name; lxc_name=$(agent_lxc_name "$name")

  echo "Removing agent '${name}' (${lxc_name})..." >&2

  wg_auth 2>/dev/null || true
  if [[ -n "$WG_PASSWORD" ]]; then
    local all_peers
    all_peers=$(curl -sf -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client" 2>/dev/null || echo "[]")
    local peer_id
    peer_id=$(echo "$all_peers" | python3 -c "
import json,sys
peers=json.load(sys.stdin)
for p in peers:
    if p.get('name') == '$name':
        print(p.get('id',''))
        break
" 2>/dev/null || true)
    if [[ -n "$peer_id" ]]; then
      curl -sf -X DELETE -b "$COOKIE_JAR" "${WG_API}/api/wireguard/client/${peer_id}" -o /dev/null 2>/dev/null || true
    fi
  fi

  lxc stop "$lxc_name" 2>/dev/null || true
  lxc delete "$lxc_name" 2>/dev/null || true
  rm -rf "${AGENTS_DIR}/${name}"

  echo "Agent '${name}' deleted." >&2
}

cmd_prepare() {
  local force=false
  [[ "${1:-}" == "--fix" ]] && force=true

  local errors=()
  local fixes=()

  echo ""
  echo "  ╔═══════════════════════════════════════════╗"
  echo "  ║   roundtable — Host Readiness Check       ║"
  echo "  ╚═══════════════════════════════════════════╝"
  echo ""

  check() {
    local label="$1" status="$2" detail="$3"
    printf "  %-35s " "${label}"
    if [ "$status" = "ok" ]; then
      echo -e "[✅] ${detail}"
    else
      echo -e "[❌] ${detail}"
    fi
  }

  if command -v docker &>/dev/null; then
    local docker_ver
    docker_ver=$(docker --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)
    if docker --version 2>/dev/null | grep -qi "snap"; then
      check "Docker (apt, not snap)" fail "installed via snap — must use apt"
      errors+=("docker-snap")
      fixes+=("snap remove docker && apt install -y docker.io docker-compose-v2")
    elif [[ -n "$docker_ver" ]]; then
      check "Docker (apt, not snap)" ok "${docker_ver}"
    else
      check "Docker (apt, not snap)" ok "installed"
    fi
  else
    check "Docker (apt, not snap)" fail "not found"
    errors+=("docker")
    fixes+=("apt install -y docker.io docker-compose-v2")
  fi

  if docker compose version &>/dev/null; then
    local compose_ver
    compose_ver=$(docker compose version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)
    check "Docker Compose v2" ok "${compose_ver:-installed}"
  else
    check "Docker Compose v2" fail "not found"
    errors+=("docker-compose")
    fixes+=("apt install -y docker-compose-v2")
  fi

  if command -v lxc &>/dev/null; then
    local lxd_ver
    lxd_ver=$(lxc version 2>/dev/null | grep -oP '\d+\.\d+' | head -1 || lxc --version 2>/dev/null | grep -oP '\d+\.\d+' | head -1)
    check "LXD" ok "${lxd_ver:-installed}"
  else
    check "LXD" fail "not found"
    errors+=("lxd")
    fixes+=("snap install lxd && lxd init --auto --storage-backend dir")
  fi

  if command -v lxc &>/dev/null; then
    local storage_info
    storage_info=$(lxc storage list 2>/dev/null | grep -v '+' | tail -n +2 | head -5)
    if echo "$storage_info" | grep -qi "dir"; then
      local pool_name
      pool_name=$(echo "$storage_info" | grep -i "dir" | awk '{print $2}')
      check "LXD storage (dir)" ok "${pool_name:-dir pool}"
    elif [[ -n "$storage_info" ]]; then
      local pool_type
      pool_type=$(echo "$storage_info" | awk '{print $4}')
      check "LXD storage (dir)" fail "found ${pool_type:-unknown} backend — needs dir"
      errors+=("lxd-storage")
      fixes+=("lxd init --auto --storage-backend dir")
    else
      check "LXD storage (dir)" fail "no storage pool configured"
      errors+=("lxd-storage")
      fixes+=("lxd init --auto --storage-backend dir")
    fi
  else
    check "LXD storage (dir)" skip "(LXD not installed)"
  fi

  if iptables -L DOCKER-USER -n -v 2>/dev/null | grep -q "lxdbr0"; then
    check "iptables (DOCKER-USER)" ok "lxdbr0 FORWARD accepted"
  else
    check "iptables (DOCKER-USER)" fail "lxdbr0 not in DOCKER-USER chain"
    errors+=("iptables")
    fixes+=("iptables -I DOCKER-USER -i lxdbr0 -j ACCEPT && iptables -I DOCKER-USER -o lxdbr0 -j ACCEPT")
  fi

  local swap_total
  swap_total=$(swapon --show=size --noheadings --bytes 2>/dev/null | awk '{s+=$1} END{printf "%.0f", s}')
  if [[ -n "$swap_total" && "$swap_total" -ge 1000000000 ]]; then
    local swap_hr
    swap_hr=$(numfmt --to=iec "$swap_total" 2>/dev/null || echo "${swap_total}B")
    check "Swap (>=1GB)" ok "${swap_hr}"
  elif [[ -n "$swap_total" ]]; then
    local swap_hr
    swap_hr=$(numfmt --to=iec "$swap_total" 2>/dev/null || echo "${swap_total}B")
    check "Swap (>=1GB)" fail "${swap_hr} — too small"
    errors+=("swap")
    fixes+=("fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile")
  else
    check "Swap (>=1GB)" fail "none"
    errors+=("swap")
    fixes+=("fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile")
  fi

  local avail_kb
  avail_kb=$(df / 2>/dev/null | awk 'NR==2 {print $4}')
  if [[ -n "$avail_kb" && "$avail_kb" -ge 5242880 ]]; then
    local avail_hr
    avail_hr=$(numfmt --to=iec "$((avail_kb * 1024))" 2>/dev/null || echo "${avail_kb}KB")
    check "Free disk (>=5GB)" ok "${avail_hr}"
  elif [[ -n "$avail_kb" ]]; then
    local avail_hr
    avail_hr=$(numfmt --to=iec "$((avail_kb * 1024))" 2>/dev/null || echo "${avail_kb}KB")
    check "Free disk (>=5GB)" fail "${avail_hr} — too low"
    errors+=("disk")
    fixes+=("Free up space — see 'docker system prune' or remove old LXD images")
  else
    check "Free disk (>=5GB)" fail "could not determine"
  fi

  if command -v python3 &>/dev/null; then
    local py_ver
    py_ver=$(python3 --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)
    check "Python 3" ok "${py_ver:-installed}"
  else
    check "Python 3" fail "not found"
    errors+=("python3")
    fixes+=("apt install -y python3")
  fi

  if command -v wg &>/dev/null; then
    local wg_ver
    wg_ver=$(wg --version 2>/dev/null | head -1 || echo "installed")
    check "wireguard-tools (wg)" ok "${wg_ver}"
  else
    check "wireguard-tools (wg)" fail "not found"
    errors+=("wireguard-tools")
    fixes+=("apt install -y wireguard-tools")
  fi

  echo ""

  if [ ${#errors[@]} -eq 0 ]; then
    echo "  ✅ All checks passed. Host is ready."
    return 0
  fi

  if $force; then
    echo "  == Auto-fixing ${#errors[@]} issue(s)..."
    echo ""

    local i=0
    for fix in "${fixes[@]}"; do
      local err="${errors[$i]}"
      echo "  [$((i+1))/${#errors[@]}] Fixing: ${err}"
      if [[ "$fix" == apt\ install* ]]; then
        if [[ $EUID -eq 0 ]]; then
          apt-get update -qq 2>/dev/null || true
          eval "$fix -qq" 2>/dev/null || true
        else
          sudo apt-get update -qq 2>/dev/null || true
          eval "sudo $fix -qq" 2>/dev/null || true
        fi
      else
        if [[ $EUID -eq 0 ]]; then
          eval "$fix" 2>/dev/null || true
        else
          eval "sudo $fix" 2>/dev/null || true
        fi
      fi
      i=$((i + 1))
    done

    echo ""
    echo "  == Re-running checks..."
    echo ""
    cmd_prepare
    return $?
  else
    echo "  ❌ ${#errors[@]} issue(s) found. To auto-fix:"
    echo ""
    echo "    sudo ./roundtable check --fix"
    echo ""
    echo "  Or fix manually:"
    echo ""
    local i=0
    for fix in "${fixes[@]}"; do
      echo "  [$((i+1))] ${fix}"
      i=$((i + 1))
    done
    echo ""
    return 1
  fi
}

load_env
cmd="${1:-help}"; shift 2>/dev/null || true

case "$cmd" in
  wg)          cmd_wg "$@" ;;
  golden-image) cmd_golden_image "$@" ;;
  agent)       cmd_agent "$@" ;;
  check|prepare|doctor|ready) cmd_prepare "$@" ;;
  help|*)      usage ;;
esac