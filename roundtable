cmd_wg_invite() {
  load_config
  [[ -n "$WG_HOST" ]] || { echo "Error: network.host not set in config" >&2; exit 1; }

  local pubkey
  pubkey=$(wg_get_own_pubkey)
  [[ -n "$pubkey" ]] || { echo "Error: ${WG_INTERFACE} not initialized. Run: roundtable wg init" >&2; exit 1; }

  # Resolve WG_HOST to IP if it's a domain
  local endpoint_ip="$WG_HOST"
  if ! echo "$WG_HOST" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
    endpoint_ip=$(host "$WG_HOST" 2>/dev/null | grep "has address" | head -1 | awk '{print $NF}' || true)
    [[ -n "$endpoint_ip" ]] || endpoint_ip="$WG_HOST"
  fi

  cat <<INVITE
# wg invite
public_key: ${pubkey}
endpoint: ${endpoint_ip}:${WG_PORT}
agents: ${AGENTS_SUBNET}
foreign: ${FOREIGN_SUBNET}
cluster: ${CLUSTER_SUBNET}
INVITE
}

cmd_wg_join() {
  local name="${1:?Usage: roundtable wg join <name> <invite-file>}"
  local invite_file="${2:?Usage: roundtable wg join <name> <invite-file>}"
  load_config
  wg_ensure_interface

  [[ -f "$invite_file" ]] || { echo "Error: invite file '${invite_file}' not found" >&2; exit 1; }
  yq_required

  # Parse invite YAML
  local remote_pubkey remote_endpoint remote_agents remote_foreign remote_cluster
  remote_pubkey=$(yq '.public_key // ""' "$invite_file")
  remote_endpoint=$(yq '.endpoint // ""' "$invite_file")
  remote_agents=$(yq '.agents // ""' "$invite_file")
  remote_foreign=$(yq '.foreign // ""' "$invite_file")
  remote_cluster=$(yq '.cluster // ""' "$invite_file")

  [[ -n "$remote_pubkey" ]] || { echo "Error: invite file missing 'public_key'" >&2; exit 1; }
  [[ -n "$remote_endpoint" ]] || { echo "Error: invite file missing 'endpoint'" >&2; exit 1; }
  [[ -n "$remote_agents" ]] || { echo "Error: invite file missing 'agents'" >&2; exit 1; }

  # Check if already joined
  local record_path; record_path=$(peer_record_path "$name" "host")
  if [[ -f "$record_path" ]]; then
    echo "Already connected to peer '${name}'. Use 'leave' first to re-join." >&2
    return 0
  fi

  # Build allowed-ips from agents + foreign subnets
  local allowed_ips="${remote_agents}"
  [[ -n "$remote_foreign" ]] && allowed_ips="${allowed_ips},${remote_foreign}"

  echo "==> Joining cluster peer '${name}'..." >&2
  echo "    Endpoint: ${remote_endpoint}" >&2
  echo "    Allowed:  ${allowed_ips}" >&2

  # Warn about subnet overlap (simple prefix check)
  if echo "$remote_agents" | grep -qE "^$(echo "$AGENTS_SUBNET" | cut -d. -f1-2)\."; then
    echo "    ⚠️  Warning: remote agents subnet '${remote_agents}' may overlap with local '${AGENTS_SUBNET}'" >&2
  fi

  # Add peer to host wg0
  wg_add_peer "$remote_pubkey" "$allowed_ips" "$remote_endpoint"

  # Install routes for each remote subnet so the kernel routes them through wg0
  local subnet
  IFS=',' read -ra subnets <<< "$allowed_ips"
  for subnet in "${subnets[@]}"; do
    ip route replace "$subnet" dev "$WG_INTERFACE" 2>/dev/null || true
  done

  # Persist cluster peer record (YAML)
  {
    echo "name: ${name}"
    echo "type: host"
    echo "public_key: ${remote_pubkey}"
    echo "endpoint: ${remote_endpoint}"
    echo "subnets:"
    echo "  agents: ${remote_agents}"
    [[ -n "$remote_foreign" ]] && echo "  foreign: ${remote_foreign}"
    echo "created: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$record_path"

  # Persist cluster peer section in wg-quick config for route restoration on boot
  wg_config_add_peer "$name" "host" "$remote_pubkey" "$allowed_ips" "$remote_endpoint"

  # Track subnets in cluster-subnets list
  subnet_list_add "$remote_agents"
  [[ -n "$remote_foreign" ]] && subnet_list_add "$remote_foreign"

  echo "==> Joined cluster peer '${name}'." >&2
  echo "    ✅ One-way connection established — ${name} can reach your agents." >&2
  echo "    ℹ️  You need to also join ${name}'s mesh for bidirectional connectivity." >&2
  echo "       Run: roundtable wg invite > my-invite.yml" >&2
  echo "       (send this file to ${name})" >&2
}

cmd_wg_leave() {
  local name="${1:?Usage: roundtable wg leave <name>}"
  load_config
  wg_ensure_interface

  local record_path; record_path=$(peer_record_path "$name" "host")
  if [[ ! -f "$record_path" ]]; then
    echo "Error: peer '${name}' not found. Use 'wg peers' to list connected peers." >&2
    exit 1
  fi

  local peer_pubkey
  peer_pubkey=$(yq '.public_key // ""' "$record_path")

  echo "==> Leaving cluster peer '${name}'..." >&2

  wg_remove_peer "$peer_pubkey"

  # Remove cluster peer section from wg-quick config
  wg_config_remove_peer "$name" "host"

  # Read subnets before deleting the record
  local agents_sub foreign_sub
  agents_sub=$(yq '.subnets.agents // ""' "$record_path")
  foreign_sub=$(yq '.subnets.foreign // ""' "$record_path")

  peer_record_delete "$name" "host"

  # Remove routes for the remote agent/foreign subnets
  [[ -n "$agents_sub" ]] && ip route del "$agents_sub" dev "$WG_INTERFACE" 2>/dev/null || true
  [[ -n "$foreign_sub" ]] && ip route del "$foreign_sub" dev "$WG_INTERFACE" 2>/dev/null || true

  [[ -n "$agents_sub" ]] && subnet_list_remove "$agents_sub"
  [[ -n "$foreign_sub" ]] && subnet_list_remove "$foreign_sub"

  echo "    Peer removed. Only affects this side." >&2
  echo "    ℹ️  '${name}' still has you as a peer until they run: roundtable wg leave ${HOSTNAME}" >&2
}

cmd_wg_peer_list() {
  load_config
  wg_ensure_interface

  printf "  %-25s %-18s %-10s %s\n" "NAME" "IP/SUBNET" "TYPE" "STATUS"

  local active_peers
  active_peers=$(wg show "$WG_INTERFACE" peers 2>/dev/null || echo "")

  if [[ -d "$PEERS_DIR" ]]; then
    for record in "$PEERS_DIR"/*.yml; do
      [[ -f "$record" ]] || continue

      local record_name record_type record_ip record_agents record_pubkey
      record_name=$(yq '.name // "?"' "$record")
      record_type=$(yq '.type // "?"' "$record")
      record_ip=$(yq '.ip // ""' "$record")
      record_agents=$(yq '.subnets.agents // ""' "$record")
      record_pubkey=$(yq '.public_key // ""' "$record")

      # Skip records where key field is missing
      [[ -n "$record_name" && "$record_name" != "null" ]] || continue

      local display_ip="${record_ip:-${record_agents:-?}}"
      local status="unknown"
      if [[ -n "$record_pubkey" ]] && echo "$active_peers" | grep -qF "$record_pubkey"; then
        status="active"
      else
        status="inactive"
      fi

      printf "  %-25s %-18s %-10s %s\n" "$record_name" "$display_ip" "$record_type" "$status"
    done
  fi
}

cmd_wg_restore() {
  # Sync wg-quick config and kernel routes from .roundtable/peers/ records.
  # Does NOT modify runtime wg0 — existing peer connections stay up.
  # Use this after upgrading roundtable to persist old peers into the new
  # config format for reboot resilience.
  load_config
  wg_ensure_interface
  init_state_dir

  local added=0 missing=0 skipped=0
  local wg_conf="/etc/wireguard/${WG_INTERFACE}.conf"

  echo "==> Restoring peers from ${PEERS_DIR}..." >&2

  for record in "$PEERS_DIR"/*.yml; do
    [[ -f "$record" ]] || continue

    local name type pubkey ip
    name=$(yq '.name // ""' "$record")
    type=$(yq '.type // ""' "$record")
    pubkey=$(yq '.public_key // ""' "$record")

    [[ -n "$name" && -n "$type" ]] || { missing=$((missing + 1)); continue; }

    if [[ "$type" == "host" ]]; then
      local agents_sub foreign_sub endpoint
      agents_sub=$(yq '.subnets.agents // ""' "$record")
      foreign_sub=$(yq '.subnets.foreign // ""' "$record")
      endpoint=$(yq '.endpoint // ""' "$record")
      local allowed_ips="$agents_sub"
      [[ -n "$foreign_sub" ]] && allowed_ips="${allowed_ips},${foreign_sub}"

      # Config peer section
      if grep -q "^# peer:${name}:host" "$wg_conf" 2>/dev/null; then
        skipped=$((skipped + 1))
      else
        wg_config_add_peer "$name" "host" "$pubkey" "$allowed_ips" "$endpoint"
        echo "    config: added host peer '${name}'" >&2
      fi

      # Routes for remote subnets
      local subnet
      for subnet in "$agents_sub" "$foreign_sub"; do
        [[ -n "$subnet" ]] || continue
        if ! ip route show dev "$WG_INTERFACE" | grep -qF "$subnet" 2>/dev/null; then
          ip route replace "$subnet" dev "$WG_INTERFACE" 2>/dev/null || true
          echo "    route: added ${subnet}" >&2
        fi
      done
    else
      ip=$(yq '.ip // ""' "$record")
      [[ -n "$ip" ]] || { missing=$((missing + 1)); continue; }

      # Ensure peer is in runtime wg0 (idempotent — harmless if already present)
      wg_add_peer "$pubkey" "${ip}/32" "${WG_HOST}:${WG_PORT}" 2>/dev/null || true

      # Config peer section
      if grep -q "^# peer:${name}:${type}" "$wg_conf" 2>/dev/null; then
        skipped=$((skipped + 1))
      else
        wg_config_add_peer "$name" "$type" "$pubkey" "${ip}/32" "${WG_HOST}:${WG_PORT}"
        echo "    config: added ${type} peer '${name}' (${ip})" >&2
      fi

      # Route
      if ! ip route show dev "$WG_INTERFACE" | grep -qF "$ip" 2>/dev/null; then
        ip route replace "${ip}/32" dev "$WG_INTERFACE" 2>/dev/null || true
        echo "    route: added ${ip}" >&2
      fi
    fi

    added=$((added + 1))
  done

  echo "    Done: ${added} peers processed, ${skipped} already current, ${missing} records with missing data." >&2
}

# ── Golden image ─────────────────────────────────────────────────

cmd_golden_image() {
  local sub="${1:-}"; shift 2>/dev/null || true
  local version="${1:-main}"
  load_config

  [[ "$sub" =~ ^(build|rebuild)$ ]] || usage

  if [ "$sub" = "rebuild" ]; then
    lxc image alias delete roundtable-agent 2>/dev/null || true
    lxc image delete roundtable-agent 2>/dev/null || true
  fi

  if lxc image alias list 2>/dev/null | grep -q roundtable-agent; then
    echo "Golden image already exists. Use 'rebuild' to replace it." >&2
    exit 1
  fi

  echo "==> Building golden image (Hermes ${version})..." >&2
  lxc launch "${UBUNTU_IMAGE}" roundtable-tmp

  echo -n "==> Waiting for network..." >&2
  for i in $(seq 1 60); do
    if lxc exec roundtable-tmp -- ping -c 1 -W 2 8.8.8.8 >/dev/null 2>&1; then
      echo " connected." >&2; break
    fi
    echo -n "." >&2; sleep 1
  done

  echo "==> Installing dependencies..." >&2
  lxc exec roundtable-tmp -- apt-get update -qq
  lxc exec roundtable-tmp -- apt-get install -y -qq wireguard-tools curl ca-certificates

  echo "==> Installing yq (mikefarah/yq v4.44.6)..." >&2
  lxc exec roundtable-tmp -- bash -c "curl -fsSL https://github.com/mikefarah/yq/releases/download/v4.44.6/yq_linux_amd64 -o /usr/local/bin/yq && chmod +x /usr/local/bin/yq"

  echo "==> Installing Hermes Agent (${version})..." >&2
  lxc exec roundtable-tmp -- bash -c "curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash -s -- --non-interactive --skip-setup --branch \"${version}\""

  echo "==> Cleaning up..." >&2
  lxc exec roundtable-tmp -- apt-get clean -qq
  lxc exec roundtable-tmp -- rm -rf /var/lib/apt/lists/*

  echo "==> Publishing image..." >&2
  lxc stop roundtable-tmp
  lxc publish roundtable-tmp --alias roundtable-agent --public=false
  lxc delete roundtable-tmp

  echo "Golden image 'roundtable-agent' (Hermes ${version}) published." >&2
  lxc image list roundtable-agent
}

# ── Agent lifecycle ──────────────────────────────────────────────

agent_lxc_name() { echo "roundtable-${1}"; }

cmd_agent_list() {
  load_config

  # Fetch latest stable release from GitHub
  echo "==> Fetching latest Hermes release..." >&2
  local latest_tag
  latest_tag=$(curl -sSf "https://api.github.com/repos/NousResearch/hermes-agent/releases/latest" 2>/dev/null \
    | grep '"tag_name"' | head -1 | cut -d'"' -f4) || latest_tag=""

  # Read containers into an array (not a while-read loop — lxc exec
  # inside a loop consumes stdin and steals remaining rows).
  local -a rows=()
  while IFS=',' read -r name status cpu ip mem; do
    rows+=("$name|$status|$cpu|$ip|$mem")
  done < <(lxc list -c n,s,config:limits.cpu,4,m -f csv "roundtable-" 2>/dev/null || true)

  if [[ ${#rows[@]} -eq 0 ]]; then
    echo "  No agents." >&2
    [[ -n "$latest_tag" ]] && echo "  Latest Hermes: ${latest_tag}" >&2
    return 0
  fi

  echo ""

  # Header
  printf "  %-20s %-10s %-30s %-16s %-6s %s\n" \
    "AGENT" "STATE" "VERSION" "LATEST" "CPU" "MEM"

  local row name status cpu ip mem version tag upgrade_str
  for row in "${rows[@]}"; do
    IFS='|' read -r name status cpu ip mem <<< "$row"
    name="${name#roundtable-}"
    status="${status,,}"

    # Get Hermes version from inside the container
    if [[ "$status" == "running" ]]; then
      version=$(lxc exec "roundtable-${name}" -- bash -c '
        for d in /opt/hermes /usr/local/lib/hermes-agent "$HOME/hermes-agent"; do
          if [ -d "$d/.git" ]; then
            git -C "$d" describe --tags --always 2>/dev/null && exit 0
          fi
        done
        echo "?"
      ' 2>/dev/null) || version="?"
      # Strip -dirty suffix for comparison
      tag="${version%%-dirty*}"
    else
      version="-"
      tag=""
    fi

    # Show upgrade status
    if [[ -n "$latest_tag" && -n "$tag" && "$tag" != "?" ]]; then
      if [[ "$tag" == "$latest_tag" ]]; then
        upgrade_str="✓"
      else
        upgrade_str="$latest_tag"
      fi
    elif [[ -n "$latest_tag" ]]; then
      upgrade_str="$latest_tag"
    else
      upgrade_str="-"
    fi

    printf "  %-20s %-10s %-30s %-16s %-6s %s\n" \
      "$name" "$status" "$version" "$upgrade_str" "$cpu" "$mem"
  done
}

cmd_agent() {
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    list)    cmd_agent_list ;;
    create)  cmd_agent_create "$@" ;;
    start|stop|restart)
      local name="${1:?Usage: roundtable agent $sub <name>}"
      lxc "$sub" "$(agent_lxc_name "$name")" ;;
    shell)   lxc exec "$(agent_lxc_name "${1:?Usage: roundtable agent shell <name>}")" bash ;;
    logs)
      local lxc_name; lxc_name=$(agent_lxc_name "${1:?Usage: roundtable agent logs <name>}")
      lxc exec "$lxc_name" -- journalctl -u "hermes*" -f 2>/dev/null || lxc exec "$lxc_name" -- journalctl -f ;;
    setup)
      lxc exec "$(agent_lxc_name "${1:?Usage: roundtable agent setup <name>}")" -- hermes setup ;;
    gateway) cmd_agent_gateway "$@" ;;
    upgrade) cmd_agent_upgrade "$@" ;;
    snapshot) cmd_agent_snapshot "$@" ;;
    export)  cmd_agent_export "$@" ;;
    import)  cmd_agent_import "$@" ;;
    delete)  cmd_agent_delete "$@" ;;
    resize)  cmd_agent_resize "$@" ;;
    *)       usage ;;
  esac
}

cmd_agent_create() {
  local name="" cpu="" memory=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cpu)
        cpu="${2:-}"
        [[ -n "$cpu" ]] || { echo "Error: --cpu requires a value" >&2; exit 1; }
        shift 2
        ;;
      --cpu=*)
        cpu="${1#*=}"
        shift
        ;;
      --memory)
        memory="${2:-}"
        [[ -n "$memory" ]] || { echo "Error: --memory requires a value" >&2; exit 1; }
        shift 2
        ;;
      --memory=*)
        memory="${1#*=}"
        shift
        ;;
      -*)
        echo "Error: unknown flag $1" >&2; exit 1
        ;;
      *)
        name="$1"
        shift
        ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable agent create <name> [--cpu N] [--memory SIZE]" >&2; exit 1; }

  local lxc_name; lxc_name=$(agent_lxc_name "$name")
  load_config

  local cpu_limit="${cpu:-$AGENT_CPU}"
  local mem_limit="${memory:-$AGENT_MEMORY}"

  if ! lxc image alias list 2>/dev/null | grep -q roundtable-agent; then
    echo "No golden image. Run: roundtable golden-image build <version>" >&2
    exit 1
  fi

  local agent_dir="${VOLUMES_DIR}/${name}"
  mkdir -p "${agent_dir}/volume"

  echo "==> Launching agent '${name}' (${lxc_name})..." >&2
  lxc launch roundtable-agent "$lxc_name" \
    -c limits.memory="${mem_limit}" \
    -c limits.cpu="${cpu_limit}" \
    -c boot.autostart=true

  lxc config device add "$lxc_name" volume disk \
    source="${agent_dir}/volume" path=/opt/data

  sleep 5

  # Create WireGuard peer
  echo "==> Setting up WireGuard peer..." >&2
  local wg_config
  wg_config=$(cmd_wg_peer_new --type agent "$name") || {
    echo "Warning: WireGuard peer creation failed. Agent created without VPN." >&2
    wg_config=""
  }

  if [[ -n "$wg_config" ]]; then
    echo "$wg_config" | lxc exec "$lxc_name" -- tee /etc/wireguard/wg0.conf > /dev/null
    lxc exec "$lxc_name" -- systemctl enable wg-quick@wg0 2>/dev/null || true
    lxc exec "$lxc_name" -- wg-quick up wg0 2>/dev/null || true
  fi

  echo "==> Agent '${name}' ready." >&2
  echo "  Mesh IP:  $(echo "$wg_config" | grep Address | head -1 | awk '{print $3}')" >&2
  echo "  Shell:     roundtable agent shell ${name}" >&2
  echo "  Setup:     roundtable agent setup ${name}" >&2
  lxc list -c n,s,4 "$lxc_name"
}

cmd_agent_gateway() {
  local action="${1:?Usage: roundtable agent gateway up|down <name>}"
  local name="${2:?Usage: roundtable agent gateway up|down <name>}"
  local lxc_name; lxc_name=$(agent_lxc_name "$name")

  case "$action" in
    up)
      echo "==> Installing and starting gateway for '${name}'..." >&2
      lxc exec "$lxc_name" -- bash -c "printf 'Y\nY\n' | hermes gateway --accept-hooks install"
      echo "Gateway started for '${name}'." >&2
      lxc exec "$lxc_name" -- hermes gateway status
      ;;
    down)
      echo "==> Stopping gateway for '${name}'..." >&2
      lxc exec "$lxc_name" -- hermes gateway stop
      echo "Gateway stopped for '${name}'." >&2
      ;;
    *)
      echo "Usage: roundtable agent gateway up|down <name>" >&2
      return 1
      ;;
  esac
}

cmd_agent_delete() {
  local name="${1:?Usage: roundtable agent delete <name>}"
  local lxc_name; lxc_name=$(agent_lxc_name "$name")

  echo "Removing agent '${name}' (${lxc_name})..." >&2

  # Clean up proxy YAML records for this agent
  if [[ -d "$PROXIES_DIR" ]]; then
    for record in "$PROXIES_DIR"/*.yml; do
      [[ -f "$record" ]] || continue
      local record_agent
      record_agent=$(yq '.agent // ""' "$record") || true
      [[ "$record_agent" == "$name" ]] || continue
      rm -f "$record"
      echo "  Proxy record cleaned: $(basename "$record")" >&2
    done
  fi

  echo "  Releasing WireGuard peer..." >&2
  # Subshell: prevents exit inside cmd_wg_peer_rm from killing the parent
  ( cmd_wg_peer_rm --type agent "$name" ) 2>/dev/null || true

  echo "  Removing LXD container..." >&2
  if lxc info "$lxc_name" &>/dev/null; then
    lxc delete --force "$lxc_name" 2>/dev/null || true
    if lxc info "$lxc_name" &>/dev/null 2>&1; then
      echo "  ⚠️  Container may not have been removed." >&2
    else
      echo "  Container removed." >&2
    fi
  else
    echo "  Container not found (already removed)." >&2
  fi

  rm -rf "${VOLUMES_DIR}/${name}"

  echo "Agent '${name}' deleted." >&2
}

# ── Agent upgrade ──────────────────────────────────────────────────
# Upgrade Hermes inside one or all agent containers.
#
# Without ``--version``, delegates to ``hermes update --yes``.
# Before delegating, fetches remote tracking branches explicitly.
# The golden image uses ``git clone --depth 1 --branch <tag>``,
# which creates no ``refs/remotes/origin/*`` refs.  ``hermes update``
# defaults to ``main`` and needs ``origin/main`` to fast-forward.
#
# With ``--version <TAG|BRANCH>``, tries ``hermes update --branch``
# first.  Branches get the full pipeline (pre-update snapshot,
# stash/pull/syntax-guard, restore).  If hermes fails with ``branch
# does not exist``, the target is a tag — falls back to
# ``git fetch --tags && git checkout <tag>``.
#
# Examples:
#   roundtable agent upgrade arthur
#   roundtable agent upgrade --all
#   roundtable agent upgrade --version v2026.8.19 arthur

upgrade_one_agent() {
  local name="$1" version="$2" lxc_name repo_root
  lxc_name=$(agent_lxc_name "$name")

  if ! lxc info "$lxc_name" &>/dev/null; then
    echo "  Agent '${name}' not found." >&2
    return 1
  fi

  echo "==> Upgrading Hermes in '${name}'..." >&2
  [[ -n "$version" ]] && echo "  Target version: ${version}" >&2

  # Find the hermes git repo inside the container.  install.sh puts it under
  # /usr/local/lib/hermes-agent (root/FHS).  The roundtable dev env puts it
  # under /opt/hermes.  Old installs may use ~/hermes-agent.
  repo_root=$(lxc exec "$lxc_name" -- bash -c '
    for d in /opt/hermes /usr/local/lib/hermes-agent "$HOME/hermes-agent"; do
      if git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then
        echo "$d"
        exit 0
      fi
    done
    exit 1
  ') || { echo "  Cannot find Hermes git repository in container." >&2; return 1; }

  if [[ -n "$version" ]]; then
    # Version update: fetch the tag and check it out.  Tags are immutable
    # so no pull / fast-forward needed after checkout.
    lxc exec "$lxc_name" -- bash -c "
      cd \"$repo_root\" || exit 1
      git fetch --tags origin
      git checkout \"$version\"
    "
  else
    # Latest update: fetch origin/main as a tracking ref, then fast-forward.
    # Explicit refspec works even when the clone is shallow (golden image)
    # and no origin/main tracking ref exists yet.
    lxc exec "$lxc_name" -- bash -c "
      cd \"$repo_root\" || exit 1
      git stash --include-untracked 2>/dev/null || true
      git fetch origin '+refs/heads/main:refs/remotes/origin/main'
      git checkout -B main origin/main
      git stash pop 2>/dev/null || true
      git pull --ff-only origin main
    "
  fi

  echo "  ✓ Upgraded." >&2

  # Restart the gateway service so it picks up the new code.
  # try-restart only restarts if the unit exists and is running.
  if lxc exec "$lxc_name" -- systemctl try-restart hermes-gateway &>/dev/null; then
    echo "  Gateway restarted." >&2
  fi
}

cmd_agent_upgrade() {
  local version="" upgrade_all=false names=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version)
        version="${2:-}"
        [[ -n "$version" ]] || { echo "Error: --version requires a tag or branch name" >&2; exit 1; }
        shift 2
        ;;
      --version=*)
        version="${1#*=}"
        shift
        ;;
      --all)
        upgrade_all=true
        shift
        ;;
      -*)
        echo "Error: unknown flag $1" >&2
        exit 1
        ;;
      *)
        names+=("$1")
        shift
        ;;
    esac
  done

  if $upgrade_all; then
    local lxc_names
    lxc_names=$(lxc list -c n -f csv "roundtable-" 2>/dev/null) || true
    [[ -z "$lxc_names" ]] && { echo "No agents found." >&2; exit 0; }
    for lxc_name in $lxc_names; do
      upgrade_one_agent "${lxc_name#roundtable-}" "$version"
    done
  elif [[ ${#names[@]} -gt 0 ]]; then
    for name in "${names[@]}"; do
      upgrade_one_agent "$name" "$version"
    done
  else
    echo "Usage: roundtable agent upgrade [--version TAG|BRANCH] [--all|<name>...]" >&2
    exit 1
  fi
}

# ── Agent snapshots ─────────────────────────────────────────────────
# LXD container snapshots capture the full filesystem and state of an
# agent. The host-side peer records, proxy records, and IP allocation
# stay unchanged. Use snapshots to roll back after a failed upgrade or
# configuration change.
#
# Examples:
#   roundtable agent snapshot create arthur
#   roundtable agent snapshot list arthur
#   roundtable agent snapshot restore arthur backup-2026-08-22T12:00:00Z
#   roundtable agent snapshot delete arthur backup-2026-08-22T12:00:00Z

cmd_agent_snapshot() {
  local action="${1:-}"; shift 2>/dev/null || true
  local name="${1:?Usage: roundtable agent snapshot create|list|restore|delete <name> [<snap>]}"
  local lxc_name; lxc_name=$(agent_lxc_name "$name")

  case "$action" in
    create)
      lxc snapshot "$lxc_name" --reuse
      echo "Snapshot created for '${name}'." >&2
      ;;
    list)
      lxc info "$lxc_name" 2>/dev/null | sed -n '/^Snapshots:/,/^[A-Z]/p' | head -n -1
      ;;
    restore)
      local snap="${1:?Usage: roundtable agent snapshot restore <name> <snapshot>}"
      lxc restore "$lxc_name" "$snap"
      echo "Snapshot '${snap}' restored for '${name}'." >&2
      ;;
    delete)
      local snap="${1:?Usage: roundtable agent snapshot delete <name> <snapshot>}"
      lxc delete "$lxc_name/$snap"
      echo "Snapshot '${snap}' deleted for '${name}'." >&2
      ;;
    *)
      echo "Usage: roundtable agent snapshot create|list|restore|delete <name> [<snap>]" >&2
      exit 1
      ;;
  esac
}

# ── Agent export ───────────────────────────────────────────────────
# Export an agent into a portable tarball for migration. The archive
# contains a LXD container export, the volume directory, and a
# manifest with proxy records. Host-side state (IP, peer keys, WG
# config) is NOT included — the import host assigns those fresh.
#
# Examples:
#   roundtable agent export arthur
#   roundtable agent export arthur --output ~/backups/

cmd_agent_export() {
  local name output_dir="."

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --output) output_dir="${2:-.}"; shift 2 ;;
      --output=*) output_dir="${1#*=}"; shift ;;
      -*)
        echo "Error: unknown flag $1" >&2
        exit 1
        ;;
      *)
        name="$1"; shift ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable agent export <name> [--output DIR]" >&2; exit 1; }

  local lxc_name; lxc_name=$(agent_lxc_name "$name")
  local agent_dir="${VOLUMES_DIR}/${name}"
  local snap_name="migrate-export"
  local ts; ts=$(date -u +%Y%m%dT%H%M%SZ)
  local workdir; workdir=$(mktemp -d)

  echo "==> Exporting agent '${name}'..." >&2

  # Stop the container for a clean filesystem state
  if lxc info "$lxc_name" &>/dev/null; then
    echo "  Stopping container..." >&2
    lxc stop "$lxc_name" 2>/dev/null || true
    sleep 2
  else
    echo "Error: agent '${name}' not found." >&2
    rm -rf "$workdir"
    exit 1
  fi

  # LXD snapshot + export (container only, no existing snapshots)
  echo "  Creating temp snapshot..." >&2
  lxc snapshot "$lxc_name" "$snap_name" 2>/dev/null && {
    echo "  Exporting container rootfs..." >&2
    lxc export "$lxc_name/$snap_name" "${workdir}/container.tar.gz" --instance-only
    lxc delete "$lxc_name/$snap_name"
  } || {
    # Fallback: export running container (may be inconsistent but still usable)
    echo "  ⚠ Snapshot failed, exporting running container..." >&2
    lxc export "$lxc_name" "${workdir}/container.tar.gz" --instance-only
  }

  echo "  Starting container..." >&2
  lxc start "$lxc_name" 2>/dev/null || true

  # Volume
  local volume_size volume_path="${agent_dir}/volume"
  if [[ -d "$volume_path" ]] && [[ -n "$(ls -A "$volume_path" 2>/dev/null)" ]]; then
    echo "  Archiving volume..." >&2
    tar czf "${workdir}/volume.tar.gz" -C "$volume_path" .
    volume_size=$(du -sh "$volume_path" | cut -f1)
  else
    volume_size="0"
  fi

  # Manifest
  local manifest="${workdir}/manifest.yml"
  {
    echo "# cli-roundtable agent export manifest"
    echo "name: ${name}"
    echo "created: ${ts}"
    echo "volume_size: ${volume_size}"
    echo "proxies:"

    if [[ -d "$PROXIES_DIR" ]]; then
      for record in "$PROXIES_DIR"/*.yml; do
        [[ -f "$record" ]] || continue
        local record_agent
        record_agent=$(yq '.agent // ""' "$record") || true
        [[ "$record_agent" == "$name" ]] || continue

        local host_port container_port public
        host_port=$(yq '.host_port // ""' "$record")
        container_port=$(yq '.container_port // ""' "$record")
        public=$(yq '.public // false' "$record")
        echo "  - host_port: ${host_port}"
        echo "    container_port: ${container_port}"
        echo "    bind_ip: \"$([ "$public" = "true" ] && echo "0.0.0.0" || echo "127.0.0.1")\""
      done
    fi
  } > "$manifest"

  # Pack outer archive
  local archive_path="${output_dir}/${name}-export-${ts}.tar.gz"
  mkdir -p "$output_dir"
  tar czf "$archive_path" -C "$workdir" .

  rm -rf "$workdir"

  echo "Exported: ${archive_path}" >&2
}

# ── Agent import ───────────────────────────────────────────────────
# Import an agent from a portable archive created by 'agent export'.
# The import host assigns new IPs and WireGuard keys. Proxy records
# from the manifest are restored. The agent container and volume are
# recreated.
#
# Examples:
#   roundtable agent import arthur arthur-export-20260822T120000Z.tar.gz

cmd_agent_import() {
  local name="${1:?Usage: roundtable agent import <name> <archive>}"
  local archive="${2:?Usage: roundtable agent import <name> <archive>}"
  local lxc_name; lxc_name=$(agent_lxc_name "$name")

  [[ -f "$archive" ]] || { echo "Error: archive not found: ${archive}" >&2; exit 1; }

  load_config
  init_state_dir

  # Check no existing container or peer
  if lxc info "$lxc_name" &>/dev/null; then
    echo "Error: agent '${name}' already exists on this host." >&2
    exit 1
  fi
  local record_path; record_path=$(peer_record_path "$name" "agent")
  if [[ -f "$record_path" ]]; then
    echo "Error: WireGuard peer '${name}' already exists on this host." >&2
    exit 1
  fi

  echo "==> Importing agent '${name}'..." >&2

  local workdir; workdir=$(mktemp -d)

  # Extract outer archive
  tar xzf "$archive" -C "$workdir"

  # Parse manifest
  local manifest="${workdir}/manifest.yml"
  if [[ ! -f "$manifest" ]]; then
    echo "Warning: manifest.yml not found. Importing without proxy records." >&2
  fi

  # Create the volume
  local agent_dir="${VOLUMES_DIR}/${name}"
  mkdir -p "${agent_dir}/volume"
  local volume_archive="${workdir}/volume.tar.gz"
  if [[ -f "$volume_archive" ]]; then
    echo "  Restoring volume..." >&2
    tar xzf "$volume_archive" -C "${agent_dir}/volume"
  fi

  # Create new WireGuard peer (allocates new IP + keys on this host)
  echo "  Creating WireGuard peer..." >&2
  local wg_config
  wg_config=$(cmd_wg_peer_new --type agent "$name") || {
    echo "Error: failed to create WireGuard peer." >&2
    rm -rf "$workdir"
    exit 1
  }

  # Import the LXD container
  local container_archive="${workdir}/container.tar.gz"
  if [[ ! -f "$container_archive" ]]; then
    echo "Error: container.tar.gz not found in archive." >&2
    rm -rf "$workdir"
    exit 1
  fi
  echo "  Importing container..." >&2
  lxc import "$container_archive" "$lxc_name"
  echo "  Starting container..." >&2
  lxc start "$lxc_name"

  # Wait for container to boot
  sleep 5

  # Override the old WG config with the new one
  local agent_conf_path; agent_conf_path=$(peer_config_path "$name" "agent")
  echo "  Installing WireGuard config..." >&2
  cat "$agent_conf_path" | lxc exec "$lxc_name" -- tee /etc/wireguard/wg0.conf > /dev/null
  lxc exec "$lxc_name" -- systemctl enable wg-quick@wg0 2>/dev/null || true
  lxc exec "$lxc_name" -- wg-quick up wg0 2>/dev/null || true

  # Attach the volume
  echo "  Attaching volume..." >&2
  lxc config device add "$lxc_name" volume disk \
    source="${agent_dir}/volume" path=/opt/data

  # Restore proxy records
  if [[ -f "$manifest" ]]; then
    local count host_port container_port bind_ip
    count=$(yq '.proxies | length' "$manifest") || true
    if [[ "$count" -gt 0 ]]; then
      echo "  Restoring proxy records..." >&2
      for i in $(seq 0 $((count - 1))); do
        host_port=$(yq ".proxies[$i].host_port" "$manifest")
        container_port=$(yq ".proxies[$i].container_port // \"\"" "$manifest")
        bind_ip=$(yq ".proxies[$i].bind_ip // \"127.0.0.1\"" "$manifest")
        [[ -n "$host_port" ]] || continue
        local public_flag=""
        [[ "$bind_ip" == "0.0.0.0" ]] && public_flag="--public"
        if [[ "$container_port" != "$host_port" && -n "$container_port" ]]; then
          cmd_proxy_enable $public_flag "${host_port}:${container_port}" "$name" 2>/dev/null || true
        else
          cmd_proxy_enable $public_flag "$host_port" "$name" 2>/dev/null || true
        fi
      done
    fi
  fi

  rm -rf "$workdir"

  local mesh_ip
  mesh_ip=$(yq '.ip // ""' "$record_path" 2>/dev/null) || mesh_ip=""

  echo "" >&2
  echo "Agent '${name}' imported." >&2
  echo "  Mesh IP:  ${mesh_ip}" >&2
  echo "  Shell:     roundtable agent shell ${name}" >&2
  echo "  Setup:     roundtable agent setup ${name}" >&2
  echo "  Gateway:   roundtable agent gateway up ${name}" >&2
  lxc list -c n,s,4 "$lxc_name"
}

# ── Agent resize ──────────────────────────────────────────────────
# Change CPU and memory limits on a running agent. Both values apply
# instantly — LXD updates the cgroup limits on the fly.
#
# Examples:
#   roundtable agent resize arthur --cpu 2
#   roundtable agent resize arthur --memory 2GB
#   roundtable agent resize arthur --cpu 4 --memory 4GB

cmd_agent_resize() {
  local name="" cpu="" memory=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cpu)
        cpu="${2:-}"
        [[ -n "$cpu" ]] || { echo "Error: --cpu requires a value" >&2; exit 1; }
        shift 2
        ;;
      --cpu=*)
        cpu="${1#*=}"
        shift
        ;;
      --memory)
        memory="${2:-}"
        [[ -n "$memory" ]] || { echo "Error: --memory requires a value" >&2; exit 1; }
        shift 2
        ;;
      --memory=*)
        memory="${1#*=}"
        shift
        ;;
      -*)
        echo "Error: unknown flag $1" >&2; exit 1
        ;;
      *)
        name="$1"
        shift
        ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable agent resize <name> [--cpu N] [--memory SIZE]" >&2; exit 1; }
  [[ -n "$cpu$memory" ]] || { echo "Error: specify at least one of --cpu or --memory" >&2; exit 1; }

  local lxc_name; lxc_name=$(agent_lxc_name "$name")
  load_config

  if ! lxc info "$lxc_name" &>/dev/null; then
    echo "Error: agent '${name}' not found." >&2
    exit 1
  fi

  if [[ -n "$cpu" ]]; then
    echo "==> Setting CPU limit: ${cpu}" >&2
    lxc config set "$lxc_name" limits.cpu "$cpu"
  fi

  if [[ -n "$memory" ]]; then
    echo "==> Setting memory limit: ${memory}" >&2
    lxc config set "$lxc_name" limits.memory "$memory"
  fi

  echo "Agent '${name}' resized." >&2
  lxc list -c n,s,4,m "$lxc_name"
}

# ── Proxy (port forwarding) ────────────────────────────────────────
# Forward host ports into agent containers via LXD proxy devices.
# State is persisted as YAML records so check --fix can restore them.

proxy_lxc_device_name() {
  local host_port="$1"
  echo "proxy-${host_port}"
}

proxy_record_path() {
  local host_port="$1" agent="$2"
  echo "${PROXIES_DIR}/${agent}-${host_port}.yml"
}

proxy_device_exists() {
  local lxc_name="$1" device="$2"
  lxc config device list "$lxc_name" 2>/dev/null | grep -qxF "$device"
}

cmd_proxy() {
  local action="${1:-}"; shift 2>/dev/null || true
  case "$action" in
    enable)  cmd_proxy_enable "$@" ;;
    disable) cmd_proxy_disable "$@" ;;
    list)    cmd_proxy_list ;;
    *)       echo "Usage: roundtable proxy enable|disable|list [args...]" >&2; exit 1 ;;
  esac
}

cmd_proxy_enable() {
  local public=false host_port="" container_port="" agent="" bind_ip="127.0.0.1"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --public) public=true; shift ;;
      --public=*) public=true; shift ;;
      *) break ;;
    esac
  done

  # Parse <port>[:<cport>]
  local port_arg="${1:-}"; shift 2>/dev/null || true
  agent="${1:-}"

  [[ -n "$port_arg" && -n "$agent" ]] || {
    echo "Usage: roundtable proxy enable [--public] <host-port>[:<container-port>] <agent>" >&2
    exit 1
  }

  if echo "$port_arg" | grep -q ':'; then
    host_port="${port_arg%%:*}"
    container_port="${port_arg##*:}"
  else
    host_port="$port_arg"
    container_port="$port_arg"
  fi

  # Validate ports are numeric
  [[ "$host_port" =~ ^[0-9]+$ && "$container_port" =~ ^[0-9]+$ ]] || {
    echo "Error: ports must be numeric" >&2
    exit 1
  }

  # Validate agent exists
  local lxc_name; lxc_name=$(agent_lxc_name "$agent")
  if ! lxc info "$lxc_name" &>/dev/null; then
    echo "Error: agent '${agent}' not found (expected LXC container '${lxc_name}')" >&2
    exit 1
  fi

  $public && bind_ip="0.0.0.0"

  load_config
  init_state_dir

  local device; device=$(proxy_lxc_device_name "$host_port")
  local record_path; record_path=$(proxy_record_path "$host_port" "$agent")

  # Check if already exists
  if proxy_device_exists "$lxc_name" "$device"; then
    echo "Proxy already exists: ${bind_ip}:${host_port} → ${agent}:${container_port}" >&2
    return
  fi

  # Create LXD proxy device
  lxc config device add "$lxc_name" "$device" proxy \
    listen="tcp:${bind_ip}:${host_port}" \
    connect="tcp:127.0.0.1:${container_port}" || {
    echo "Error: failed to create proxy device" >&2
    exit 1
  }

  # Persist YAML record
  cat > "$record_path" <<PROXYEOF
agent: ${agent}
host_port: ${host_port}
container_port: ${container_port}
bind: ${bind_ip}
created: $(date -u +%Y-%m-%dT%H:%M:%SZ)
PROXYEOF

  echo "  Proxy: ${bind_ip}:${host_port} → ${agent}:${container_port} [✅ active]"
}

cmd_proxy_disable() {
  local host_port="" container_port="" agent=""

  local port_arg="${1:-}"; shift 2>/dev/null || true
  agent="${1:-}"

  [[ -n "$port_arg" && -n "$agent" ]] || {
    echo "Usage: roundtable proxy disable <host-port>[:<container-port>] <agent>" >&2
    exit 1
  }

  if echo "$port_arg" | grep -q ':'; then
    host_port="${port_arg%%:*}"
    container_port="${port_arg##*:}"
  else
    host_port="$port_arg"
    container_port="$port_arg"
  fi

  [[ "$host_port" =~ ^[0-9]+$ ]] || {
    echo "Error: port must be numeric" >&2
    exit 1
  }

  local lxc_name; lxc_name=$(agent_lxc_name "$agent")
  local device; device=$(proxy_lxc_device_name "$host_port")
  local record_path; record_path=$(proxy_record_path "$host_port" "$agent")

  # Remove LXD device if it exists
  if proxy_device_exists "$lxc_name" "$device" 2>/dev/null; then
    lxc config device remove "$lxc_name" "$device" || true
  fi

  # Remove YAML record
  rm -f "$record_path"

  echo "  Proxy ${host_port}:${container_port} → ${agent} removed."
}

cmd_proxy_list() {
  init_state_dir

  if ! ls "$PROXIES_DIR"/*.yml &>/dev/null 2>&1; then
    echo "  No proxy forwardings configured."
    return 0
  fi

  printf "  %-20s %-20s %-25s %s\n" "AGENT" "HOST:PORT" "→ AGENT:PORT" "STATUS"

  for record in "$PROXIES_DIR"/*.yml; do
    local agent cport hport bind_ip
    agent=$(yq '.agent' "$record")
    hport=$(yq '.host_port' "$record")
    cport=$(yq '.container_port' "$record")
    bind_ip=$(yq '.bind' "$record")

    local lxc_name; lxc_name=$(agent_lxc_name "$agent")
    local device; device=$(proxy_lxc_device_name "$hport")
    local status

    if ! lxc info "$lxc_name" &>/dev/null; then
      status="[❌] container gone"
    elif proxy_device_exists "$lxc_name" "$device"; then
      status="[✅] active"
    else
      status="[⚠] device missing"
    fi

    printf "  %-20s %-20s %-25s %s\n" "${agent}" "${bind_ip}:${hport}" "${agent}:${cport}" "${status}"
  done
}

proxy_restore_missing() {
  # Called by check --fix — re-creates LXD proxy devices from YAML records
  local restored=0
  for record in "$PROXIES_DIR"/*.yml; do
    [[ -f "$record" ]] || continue
    local agent hport cport bind_ip
    agent=$(yq '.agent' "$record")
    hport=$(yq '.host_port' "$record")
    cport=$(yq '.container_port' "$record")
    bind_ip=$(yq '.bind' "$record")

    local lxc_name; lxc_name=$(agent_lxc_name "$agent")
    local device; device=$(proxy_lxc_device_name "$hport")

    if ! lxc info "$lxc_name" &>/dev/null; then
      echo "  [–] Proxy ${bind_ip}:${hport} → ${agent}:${cport}: agent container missing" >&2
      continue
    fi

    if proxy_device_exists "$lxc_name" "$device"; then
      continue
    fi

    echo "  Restoring proxy: ${bind_ip}:${hport} → ${agent}:${cport}" >&2
    lxc config device add "$lxc_name" "$device" proxy \
      listen="tcp:${bind_ip}:${hport}" \
      connect="tcp:127.0.0.1:${cport}" 2>/dev/null || true
    restored=$((restored + 1))
  done
  echo "  Restored ${restored} proxy device(s)." >&2
}

# ── MCP server ──────────────────────────────────────────────────────
# MCP (Model Context Protocol) server that exposes roundtable commands
# to Hermes agents over HTTP. Each agent authenticates with a bearer
# token and is restricted to its granted permission patterns.
#
# Examples:
#   roundtable mcp start
#   roundtable mcp install worker-bee --allow "agent list,agent create *"
#   roundtable mcp list

MCP_SERVICE="roundtable-mcp.service"

generate_api_key() {
  if command -v openssl &>/dev/null; then
    echo "rtk_$(openssl rand -hex 32 2>/dev/null)"
  else
    python3 -c "import secrets; print('rtk_' + secrets.token_hex(32))"
  fi
}

cmd_mcp() {
  local sub="${1:-}"; shift 2>/dev/null || true
  case "$sub" in
    start)       cmd_mcp_start "$@" ;;
    stop)        cmd_mcp_stop ;;
    restart)     cmd_mcp_restart ;;
    status)      cmd_mcp_status ;;
    install)     cmd_mcp_install "$@" ;;
    uninstall)   cmd_mcp_uninstall "$@" ;;
    grant)       cmd_mcp_grant "$@" ;;
    revoke)      cmd_mcp_revoke "$@" ;;
    permissions) cmd_mcp_permissions "$@" ;;
    list)        cmd_mcp_list ;;
    *)           echo "Usage: roundtable mcp start|stop|restart|status|install|uninstall|grant|revoke|permissions|list [args...]" >&2; exit 1 ;;
  esac
}

cmd_mcp_start() {
  local bind="" port=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --bind) bind="${2:-}"; shift 2 ;;
      --bind=*) bind="${1#*=}"; shift ;;
      --port) port="${2:-}"; shift 2 ;;
      --port=*) port="${1#*=}"; shift ;;
      *) echo "Error: unknown flag $1" >&2; exit 1 ;;
    esac
  done

  load_config
  init_state_dir

  # Write mcp config
  local mcp_conf="${ROUNDTABLE_DIR}/mcp.yml"
  local host_ip
  host_ip=$(echo "$AGENTS_SUBNET" | sed 's|0/24$|1/24|' | sed 's|/24$||')
  {
    echo "bind: ${bind:-$host_ip}"
    echo "port: ${port:-8342}"
    echo "roundtable: ${ROOT}/roundtable"
  } > "$mcp_conf"

  # Create systemd unit
  local unit="/etc/systemd/system/${MCP_SERVICE}"
  cat > "$unit" <<UNITEOF
[Unit]
Description=roundtable MCP server
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 ${ROOT}/mcp-server.py
WorkingDirectory=${ROOT}
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
UNITEOF

  systemctl daemon-reload
  systemctl enable "${MCP_SERVICE}"
  systemctl start "${MCP_SERVICE}"

  # Wait for health
  local host_ip
  host_ip=$(echo "$AGENTS_SUBNET" | sed 's|0/24$|1/24|' | sed 's|/24$||')
  local target="${bind:-$host_ip}"
  local target_port="${port:-8342}"
  for i in 1 2 3 4 5; do
    if curl -sf "http://${target}:${target_port}/health" &>/dev/null; then
      echo "MCP server started on ${target}:${target_port}" >&2
      return 0
    fi
    sleep 1
  done

  echo "Warning: MCP server may not be ready. Check: systemctl status ${MCP_SERVICE}" >&2
}

cmd_mcp_stop() {
  if systemctl is-active "${MCP_SERVICE}" &>/dev/null; then
    systemctl stop "${MCP_SERVICE}"
    echo "MCP server stopped." >&2
  else
    echo "MCP server is not running." >&2
  fi
}

cmd_mcp_restart() {
  cmd_mcp_stop
  sleep 1
  cmd_mcp_start "$@"
}

cmd_mcp_status() {
  if systemctl is-active "${MCP_SERVICE}" &>/dev/null; then
    systemctl status "${MCP_SERVICE}" --no-pager 2>&1 | head -20
    echo ""
    # Show config info
    local mcp_conf="${ROUNDTABLE_DIR}/mcp.yml"
    if [[ -f "$mcp_conf" ]]; then
      echo "Config: ${mcp_conf}"
      cat "$mcp_conf"
    fi
  else
    echo "MCP server is not running." >&2
    echo "  Start: roundtable mcp start [--bind IP] [--port PORT]" >&2
  fi
}

cmd_mcp_install() {
  local name="" allow_str=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --allow)
        allow_str="${2:-}"
        [[ -n "$allow_str" ]] || { echo "Error: --allow requires a comma-separated list" >&2; exit 1; }
        shift 2
        ;;
      --allow=*) allow_str="${1#*=}"; shift ;;
      -*) echo "Error: unknown flag $1" >&2; exit 1 ;;
      *) name="$1"; shift ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable mcp install <name> [--allow \"p1,p2\"]" >&2; exit 1; }

  load_config
  init_state_dir

  # Verify agent exists (peer record or container)
  local lxc_name; lxc_name=$(agent_lxc_name "$name")
  local record_path; record_path=$(peer_record_path "$name" "agent")

  if [[ -f "$record_path" ]]; then
    echo "  Using peer record for '${name}'." >&2
  elif lxc info "$lxc_name" &>/dev/null; then
    echo "  Using container for '${name}'." >&2
  else
    echo "Error: agent '${name}' not found. Create it first or check the name." >&2
    exit 1
  fi

  # Check not already installed
  if [[ -f "${API_KEYS_DIR}/${name}" ]]; then
    echo "Error: agent '${name}' already has MCP access. Use 'mcp uninstall ${name}' first." >&2
    exit 1
  fi

  # Generate API key
  local api_key; api_key=$(generate_api_key)
  echo "$api_key" > "${API_KEYS_DIR}/${name}"
  chmod 600 "${API_KEYS_DIR}/${name}"

  # Write permissions
  local perm_file="${PERMISSIONS_DIR}/${name}.yml"
  echo "allow:" > "$perm_file"
  if [[ -n "$allow_str" ]]; then
    IFS=',' read -ra patterns <<< "$allow_str"
    for pat in "${patterns[@]}"; do
      pat="${pat#"${pat%%[! ]*}"}"   # trim leading whitespace
      pat="${pat%"${pat##*[! ]}"}"   # trim trailing whitespace
      echo "  - \"${pat}\"" >> "$perm_file"
    done
  fi

  echo "MCP access installed for '${name}'." >&2
  echo "  API key: ${api_key}" >&2
  echo "  File:    ${API_KEYS_DIR}/${name}" >&2
  echo "  Permissions:" >&2
  if [[ -n "$allow_str" ]]; then
    echo "    ${allow_str}" >&2
  else
    echo "    (none — use 'mcp grant ${name} ...' to add)" >&2
  fi
  echo "" >&2
  echo "Deploy this key to the agent's Hermes config:" >&2
  echo "  mcp_servers:" >&2
  echo "    roundtable-cluster:" >&2
  echo "      url: http://<host-mesh-ip>:8342" >&2
  echo "      headers:" >&2
  echo "        Authorization: Bearer ${api_key}" >&2
}

cmd_mcp_uninstall() {
  local name="${1:?Usage: roundtable mcp uninstall <name>}"
  local removed=false

  if [[ -f "${API_KEYS_DIR}/${name}" ]]; then
    rm -f "${API_KEYS_DIR}/${name}"
    echo "  API key removed." >&2
    removed=true
  fi

  if [[ -f "${PERMISSIONS_DIR}/${name}.yml" ]]; then
    rm -f "${PERMISSIONS_DIR}/${name}.yml"
    echo "  Permissions removed." >&2
    removed=true
  fi

  if [[ "$removed" == "false" ]]; then
    echo "Error: agent '${name}' does not have MCP access." >&2
    exit 1
  fi

  echo "MCP access uninstalled for '${name}'." >&2
}

cmd_mcp_grant() {
  local name="" allow_str=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -*) echo "Error: unknown flag $1" >&2; exit 1 ;;
      *) name="$1"; shift; break ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable mcp grant <name> \"perm1,perm2\"" >&2; exit 1; }
  allow_str="${1:-}"
  [[ -n "$allow_str" ]] || { echo "Usage: roundtable mcp grant <name> \"perm1,perm2\"" >&2; exit 1; }

  local perm_file="${PERMISSIONS_DIR}/${name}.yml"
  if [[ ! -f "$perm_file" ]]; then
    echo "Error: agent '${name}' does not have MCP access. Install first." >&2
    exit 1
  fi

  # Ensure it ends with an allow: header if empty
  local has_allow
  has_allow=$(head -1 "$perm_file" 2>/dev/null)
  if [[ "$has_allow" != "allow:" ]]; then
    echo "allow:" > "$perm_file"
  fi

  # Append patterns
  IFS=',' read -ra patterns <<< "$allow_str"
  for pat in "${patterns[@]}"; do
    pat="${pat#"${pat%%[! ]*}"}"
    pat="${pat%"${pat##*[! ]}"}"
    echo "  - \"${pat}\"" >> "$perm_file"
  done

  echo "Granted permissions to '${name}': ${allow_str}" >&2
}

cmd_mcp_revoke() {
  local name="" patterns_to_remove=() remove_all=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --all) remove_all=true; shift ;;
      -*) echo "Error: unknown flag $1" >&2; exit 1 ;;
      *) name="$1"; shift; break ;;
    esac
  done

  [[ -n "$name" ]] || { echo "Usage: roundtable mcp revoke <name> \"p1,p2\"|--all" >&2; exit 1; }

  local perm_file="${PERMISSIONS_DIR}/${name}.yml"
  if [[ ! -f "$perm_file" ]]; then
    echo "Error: agent '${name}' does not have MCP access." >&2
    exit 1
  fi

  if [[ "$remove_all" == "true" ]]; then
    echo "allow:" > "$perm_file"
    echo "All permissions revoked for '${name}'." >&2
    return 0
  fi

  local revoke_str="${1:-}"
  [[ -n "$revoke_str" ]] || { echo "Usage: roundtable mcp revoke <name> \"p1,p2\"|--all" >&2; exit 1; }

  IFS=',' read -ra patterns <<< "$revoke_str"
  for pat in "${patterns[@]}"; do
    pat="${pat#"${pat%%[! ]*}"}"
    pat="${pat%"${pat##*[! ]}"}"
    patterns_to_remove+=("$pat")
  done

  # Rebuild file without matching patterns
  local tmp_file; tmp_file=$(mktemp)
  echo "allow:" > "$tmp_file"
  local removed=0
  while IFS= read -r line; do
    [[ "$line" == "allow:" ]] && continue
    local stripped
    stripped=$(echo "$line" | sed 's/^[[:space:]]*-[[:space:]]*//' | tr -d '"')
    local keep=true
    for rp in "${patterns_to_remove[@]}"; do
      if [[ "$stripped" == "$rp" ]]; then
        keep=false
        removed=$((removed + 1))
        break
      fi
    done
    if [[ "$keep" == "true" ]] && [[ -n "$stripped" ]]; then
      echo "$line" >> "$tmp_file"
    fi
  done < "$perm_file"

  mv "$tmp_file" "$perm_file"
  echo "Removed ${removed} permission pattern(s) from '${name}'." >&2
}

cmd_mcp_permissions() {
  local name="${1:?Usage: roundtable mcp permissions <name>}"

  echo "Agent: ${name}"
  echo ""

  if [[ -f "${API_KEYS_DIR}/${name}" ]]; then
    local key; key=$(cat "${API_KEYS_DIR}/${name}")
    local fp; fp=$(echo "$key" | sha256sum | cut -c1-16)
    echo "  API key:      ${key}"
    echo "  Fingerprint:  SHA256:${fp}"
  else
    echo "  API key:      (none)"
  fi
  echo ""

  local perm_file="${PERMISSIONS_DIR}/${name}.yml"
  if [[ -f "$perm_file" ]]; then
    echo "  Permissions:"
    while IFS= read -r line; do
      local stripped
      stripped=$(echo "$line" | sed 's/^[[:space:]]*//')
      if [[ "$stripped" == "-"* ]]; then
        echo "    ${stripped}"
      fi
    done < "$perm_file"
  else
    echo "  Permissions:  (none)"
  fi
}

cmd_mcp_list() {
  load_config
  init_state_dir

  echo "Authorized agents:"
  echo ""

  local has_any=false
  if [[ -d "$API_KEYS_DIR" ]]; then
    for f in "$API_KEYS_DIR"/*; do
      [[ -f "$f" ]] || continue
      [[ "$(basename "$f")" == ".gitignore" ]] && continue
      local agent; agent=$(basename "$f")
      local key; key=$(cat "$f")
      local fp; fp=$(echo "$key" | sha256sum | cut -c1-16)
      local perms=""
      if [[ -f "${PERMISSIONS_DIR}/${agent}.yml" ]]; then
        perms=$(grep -c '^-' "${PERMISSIONS_DIR}/${agent}.yml" 2>/dev/null || echo "0")
        perms="${perms} pattern(s)"
      else
        perms="no permission file"
      fi
      printf "  %-20s key: %s (SHA256:%s) — %s\n" "$agent" "$key" "$fp" "$perms"
      has_any=true
    done
  fi

  if [[ "$has_any" == "false" ]]; then
    echo "  (no agents authorized — use 'mcp install <name>')"
  fi

  echo ""
  echo "MCP server:"
  if systemctl is-active "${MCP_SERVICE}" &>/dev/null; then
    local mcp_conf="${ROUNDTABLE_DIR}/mcp.yml"
    local bind="10.0.1.1"
    local port="8342"
    if [[ -f "$mcp_conf" ]]; then
      bind=$(grep '^bind:' "$mcp_conf" | awk '{print $2}')
      port=$(grep '^port:' "$mcp_conf" | awk '{print $2}')
    fi
    echo "  Status:   running"
    echo "  Connect:  http://${bind}:${port}"
    systemctl show -p MainPID,ActiveEnterTimestamp "${MCP_SERVICE}" 2>/dev/null | head -2 | sed 's/^/  /'
  else
    echo "  Status:   not running"
  fi
}

# ── Host check ───────────────────────────────────────────────────

cmd_check() {
  local force=false
  [[ "${1:-}" == "--fix" ]] && force=true

  local errors=()
  local fixes=()
  local workspace_warning=false
  local proxy_warning=false

  # Transparently escalate privileged commands when running as non-root
  # (roundtable user has passwordless sudo via NOPASSWD:ALL)
  if [[ $EUID -ne 0 ]]; then
    lxc()    { command sudo lxc "$@"; }
    iptables() { command sudo iptables "$@"; }
    swapon() { command sudo swapon "$@"; }
    wg()     { command sudo wg "$@"; }
  fi

  echo ""
  echo "  ╔═══════════════════════════════════════════╗"
  echo "  ║   roundtable — Host Readiness Check       ║"
  echo "  ╚═══════════════════════════════════════════╝"
  echo ""

  # Version info
  local version_str
  version_str=$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo "unknown")
  if [[ "$ROUNDTABLE_BRANCH" == "main" ]]; then
    printf "  %-35s %s\\n" "Roundtable" "[${version_str}] — unstable build"
  else
    local latest
    latest=$(git -C "$ROOT" tag --list 'v*' --sort=-version:refname 2>/dev/null | head -1 || echo "")
    if [[ -n "$latest" ]]; then
      if echo "$version_str" | grep -q "^${latest}"; then
        printf "  %-35s %s\\n" "Roundtable" "[${version_str}] — up to date"
      else
        printf "  %-35s %s\\n" "Roundtable" "[${version_str}] — upgrade to ${latest} available"
      fi
    else
      printf "  %-35s %s\\n" "Roundtable" "[${version_str}]"
    fi
  fi
  echo ""

  check() {
    local label="$1" status="$2" detail="$3"
    printf "  %-35s " "${label}"
    if [ "$status" = "ok" ]; then
      echo -e "[✅] ${detail}"
    elif [ "$status" = "skip" ]; then
      echo -e "[–] ${detail}"
    elif [ "$status" = "warn" ]; then
      echo -e "[⚠] ${detail}"
    else
      echo -e "[❌] ${detail}"
    fi
  }

  # yq (new dependency)
  if command -v yq &>/dev/null; then
    local yq_ver
    yq_ver=$(yq --version 2>/dev/null | grep -oP 'v\S+' || echo "installed")
    check "yq (mikefarah/yq)" ok "${yq_ver}"
  else
    check "yq (mikefarah/yq)" fail "not found"
    errors+=("yq")
    fixes+=("curl -fsSL https://github.com/mikefarah/yq/releases/download/v4.44.6/yq_linux_amd64 -o /usr/local/bin/yq && chmod +x /usr/local/bin/yq")
  fi

  # Config
  if [[ -f "$CONFIG" ]]; then
    check "Config (config.yml)" ok "present"
  else
    check "Config (config.yml)" fail "not found"
    errors+=("config")
    fixes+=("cp config.example.yml config.yml && vi config.yml")
  fi

  if command -v lxc &>/dev/null; then
    local lxd_ver
    lxd_ver=$(lxc version 2>/dev/null | grep -oP '\d+\.\d+' | head -1 || lxc --version 2>/dev/null | grep -oP '\d+\.\d+' | head -1)
    check "LXD" ok "${lxd_ver:-installed}"
  else
    check "LXD" fail "not found"
    errors+=("lxd")
    fixes+=("snap install lxd && lxd init --auto --storage-backend dir")
  fi

  if command -v lxc &>/dev/null; then
    local storage_info
    storage_info=$(lxc storage list 2>/dev/null | grep -v '+' | tail -n +2 | head -5) || true
    if echo "$storage_info" | grep -qi "dir"; then
      local pool_name
      pool_name=$(echo "$storage_info" | grep -i "dir" | awk '{print $2}')
      check "LXD storage (dir)" ok "${pool_name:-dir pool}"
    elif [[ -n "$storage_info" ]]; then
      local pool_type
      pool_type=$(echo "$storage_info" | awk '{print $4}')
      check "LXD storage (dir)" fail "found ${pool_type:-unknown} backend"
      errors+=("lxd-storage")
      fixes+=("lxd init --auto --storage-backend dir")
    else
      check "LXD storage (dir)" fail "no storage pool configured"
      errors+=("lxd-storage")
      fixes+=("lxd init --auto --storage-backend dir")
    fi
  else
    check "LXD storage (dir)" skip "(LXD not installed)"
  fi

  if iptables -L DOCKER-USER -n -v 2>/dev/null | grep -q "lxdbr0"; then
    check "iptables (DOCKER-USER)" ok "lxdbr0 FORWARD accepted"
  else
    if iptables -L DOCKER-USER -n 2>/dev/null | grep -q "Chain DOCKER-USER"; then
      check "iptables (DOCKER-USER)" fail "lxdbr0 not in DOCKER-USER chain"
      errors+=("iptables")
      fixes+=("iptables -I DOCKER-USER -i lxdbr0 -j ACCEPT && iptables -I DOCKER-USER -o lxdbr0 -j ACCEPT")
    else
      check "iptables (DOCKER-USER)" skip "(DOCKER-USER chain doesn't exist)"
    fi
  fi

  local swap_total
  swap_total=$(swapon --show=size --noheadings --bytes 2>/dev/null | awk '{s+=$1} END{printf "%.0f", s}') || true
  if [[ -n "$swap_total" && "$swap_total" -ge 1000000000 ]]; then
    local swap_hr
    swap_hr=$(numfmt --to=iec "$swap_total" 2>/dev/null || echo "${swap_total}B")
    check "Swap (>=1GB)" ok "${swap_hr}"
  elif [[ -n "$swap_total" ]]; then
    local swap_hr
    swap_hr=$(numfmt --to=iec "$swap_total" 2>/dev/null || echo "${swap_total}B")
    check "Swap (>=1GB)" fail "${swap_hr} — too small"
    errors+=("swap")
    fixes+=("fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile")
  else
    check "Swap (>=1GB)" fail "none"
    errors+=("swap")
    fixes+=("fallocate -l 1G /swapfile && chmod 600 /swapfile && mkswap /swapfile && swapon /swapfile")
  fi

  local avail_kb
  avail_kb=$(df / 2>/dev/null | awk 'NR==2 {print $4}')
  if [[ -n "$avail_kb" && "$avail_kb" -ge 5242880 ]]; then
    local avail_hr
    avail_hr=$(numfmt --to=iec "$((avail_kb * 1024))" 2>/dev/null || echo "${avail_kb}KB")
    check "Free disk (>=5GB)" ok "${avail_hr}"
  elif [[ -n "$avail_kb" ]]; then
    local avail_hr
    avail_hr=$(numfmt --to=iec "$((avail_kb * 1024))" 2>/dev/null || echo "${avail_kb}KB")
    check "Free disk (>=5GB)" fail "${avail_hr} — too low"
    errors+=("disk")
    fixes+=("Free up space — see 'docker system prune' or delete old LXD images")
  else
    check "Free disk (>=5GB)" fail "could not determine"
  fi

  if command -v python3 &>/dev/null; then
    local py_ver
    py_ver=$(python3 --version 2>/dev/null | grep -oP '\d+\.\d+\.\d+' | head -1)
    check "Python 3" ok "${py_ver:-installed}"
  else
    check "Python 3" fail "not found"
    errors+=("python3")
    fixes+=("apt install -y python3")
  fi

  if command -v wg &>/dev/null; then
    local wg_ver
    wg_ver=$(wg --version 2>/dev/null | head -1 || echo "installed")
    check "wireguard-tools (wg)" ok "${wg_ver}"
  else
    check "wireguard-tools (wg)" fail "not found"
    errors+=("wireguard-tools")
    fixes+=("apt install -y wireguard-tools")
  fi

  # Load config for wg interface check (only if available)
  if command -v yq &>/dev/null && [[ -f "$CONFIG" ]]; then
    local check_iface
    check_iface=$(yq '.network.wg.interface // "wg0"' "$CONFIG")
    if ip link show "$check_iface" &>/dev/null; then
      check "Host ${check_iface}" ok "interface up"
    else
      check "Host ${check_iface}" fail "not configured (run: roundtable wg init)"
      errors+=("wg0")
      fixes+=("roundtable wg init")
    fi
  else
    check "Host wg0" skip "(config not available)"
  fi

  # Check if AppArmor blocks wg-quick IPv4 sockets
  if command -v aa-status &>/dev/null && aa-status 2>/dev/null | grep -q "wg-quick"; then
    if [[ -f /etc/apparmor.d/local/wg-quick ]] && grep -q "network inet dgram" /etc/apparmor.d/local/wg-quick 2>/dev/null; then
      check "AppArmor wg-quick" ok "IPv4 sockets allowed"
    else
      check "AppArmor wg-quick" fail "blocks IPv4 sockets"
      errors+=("apparmor-wg")
      fixes+=("echo \"network inet dgram,\" >> /etc/apparmor.d/local/wg-quick && apparmor_parser -r /etc/apparmor.d/wg-quick")
    fi
  else
    check "AppArmor wg-quick" skip "(not enabled)"
  fi

  if [[ "$(cat /proc/sys/net/ipv4/ip_forward 2>/dev/null)" == "1" ]]; then
    check "IP forwarding" ok "enabled"
  else
    check "IP forwarding" fail "disabled"
    errors+=("ip_forward")
    fixes+=("sysctl -w net.ipv4.ip_forward=1")
  fi

  # SSH user workspace (informational, not blocking)
  if id "$SSH_USER" &>/dev/null; then
    local key_count
    key_count=$(grep -c "^# peer:" "$SSH_AUTH_KEYS" 2>/dev/null || echo 0)
    if [[ "$key_count" -gt 0 ]]; then
      if ssh_access_is_setup; then
        check "SSH user workspace" ok "configured"
      else
        check "SSH user workspace" warn "not configured"
        workspace_warning=true
      fi
    else
      check "SSH user workspace" skip "(no SSH keys)"
    fi
  fi

  # Proxy devices (informational, not blocking)
  if ls "$PROXIES_DIR"/*.yml &>/dev/null 2>&1; then
    local missing=0
    for record in "$PROXIES_DIR"/*.yml; do
      local agent hport
      agent=$(yq '.agent' "$record")
      hport=$(yq '.host_port' "$record")
      local lxc_name; lxc_name=$(agent_lxc_name "$agent")
      local device; device=$(proxy_lxc_device_name "$hport")
      if ! lxc info "$lxc_name" &>/dev/null || ! proxy_device_exists "$lxc_name" "$device"; then
        missing=$((missing + 1))
      fi
    done
    if [[ "$missing" -eq 0 ]]; then
      check "Proxy devices" ok "all active"
    else
      check "Proxy devices" warn "${missing} device(s) missing"
      proxy_warning=true
    fi
  fi

  if host cloud-images.ubuntu.com &>/dev/null 2>&1; then
    check "Ubuntu image (DNS)" ok "cloud-images.ubuntu.com resolvable"
  else
    check "Ubuntu image (DNS)" fail "cloud-images.ubuntu.com not resolvable"
    errors+=("dns")
    fixes+=("dns")
  fi

  echo ""

  if [ ${#errors[@]} -eq 0 ] && ! $workspace_warning && ! $proxy_warning; then
      echo "  ✅ All checks passed. Host is ready."
      return 0
    fi

    if $force; then
      # Run auto-fixes for hard errors first
      if [ ${#errors[@]} -gt 0 ]; then
        echo "  == Auto-fixing ${#errors[@]} issue(s)..."
        echo ""

        local i=0
        for fix in "${fixes[@]}"; do
          local err="${errors[$i]}"
          echo "  [$((i+1))/${#errors[@]}] Fixing: ${err}"
          if [[ "$fix" == apt\ install* ]]; then
            if [[ $EUID -eq 0 ]]; then
              apt-get update -qq 2>/dev/null || true
              eval "$fix -qq" 2>/dev/null || true
            else
              sudo apt-get update -qq 2>/dev/null || true
              eval "sudo $fix -qq" 2>/dev/null || true
            fi
          elif [[ "$fix" == curl* ]]; then
            if [[ $EUID -eq 0 ]]; then
              eval "$fix" 2>/dev/null || true
            else
              eval "sudo $fix" 2>/dev/null || true
            fi
          elif [[ "$fix" == roundtable* || "$fix" == cp\ .roundtable* ]]; then
            eval "$fix" 2>/dev/null || true
          elif [[ "$fix" == "dns" ]]; then
            cmd_fix_dns
          else
            if [[ $EUID -eq 0 ]]; then
              eval "$fix" 2>/dev/null || true
            else
              eval "sudo $fix" 2>/dev/null || true
            fi
          fi
          i=$((i + 1))
        done
      fi

      # Then prompt for workspace (interactive, only in --fix mode)
      if $workspace_warning; then
        echo "" >&2
        read -p "  Set up roundtable user workspace (symlink, PATH, permissions)? [y/N] " response
        if [[ "$response" =~ ^[Yy]$ ]]; then
          ssh_ensure_access
        else
          echo "  Skipped." >&2
        fi
      fi

      # Restore missing proxy devices (non-interactive)
      if $proxy_warning; then
        proxy_restore_missing
      fi

      echo ""
      echo "  == Re-running checks..."
      echo ""
      cmd_check

      # After all fixes are applied, prompt for roundtable upgrade (optional)
      if [[ "${#errors[@]}" -eq 0 ]]; then
        if [[ "$ROUNDTABLE_BRANCH" == "main" ]]; then
          echo ""
          echo "  You are on the unstable (main) branch."
          echo "  Run 'roundtable upgrade' to fast-forward if behind."
        else
          local current_version
          current_version=$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo "unknown")
          local latest_tag
          latest_tag=$(git -C "$ROOT" tag --list 'v*' --sort=-version:refname 2>/dev/null | head -1 || echo "")
          if [[ -n "$latest_tag" ]] && ! echo "$current_version" | grep -q "^${latest_tag}"; then
            echo ""
            read -p "  Upgrade roundtable to latest version (${latest_tag})? [y/N] " response
            if [[ "$response" =~ ^[Yy]$ ]]; then
              echo ""
              cmd_roundtable_upgrade --version "$latest_tag"
              echo ""
              echo "  == Re-running checks after upgrade..."
              echo ""
              cmd_check
            fi
          fi
        fi
      fi

      return $?
    fi

    # Non-fix mode warnings
    local warnings=""
    $workspace_warning && warnings="${warnings}\n  ⚠ SSH user workspace not configured."
    $proxy_warning && warnings="${warnings}\n  ⚠ Proxy device(s) missing."
    if [[ -n "$warnings" && ${#errors[@]} -eq 0 ]]; then
      echo -e "$warnings"
      echo ""
      echo "    Run: sudo ./roundtable check --fix"
      echo ""
      return 1
    fi

  echo "  ❌ ${#errors[@]} issue(s) found. To auto-fix:"
  echo ""
  echo "    sudo ./roundtable check --fix"
  echo ""
  echo "  Or fix manually:"
  echo ""
  local i=0
  for fix in "${fixes[@]}"; do
    echo "  [$((i+1))] ${fix}"
    i=$((i + 1))
  done
  echo ""
  return 1
}

# ── DNS diagnostics ──────────────────────────────────────────────
cmd_fix_dns() {
  echo ""
  echo "  DNS resolution for cloud-images.ubuntu.com failed."
  echo "  This blocks LXD from downloading the golden image base."
  echo ""

  if ! command -v resolvectl &>/dev/null; then
    echo "  systemd-resolved not active. Check /etc/resolv.conf manually."
    return 1
  fi

  local link="eth0"
  local status_output
  status_output=$(resolvectl status "$link" 2>/dev/null)
  local current_dns
  current_dns=$(echo "$status_output" | grep "DNS Servers:" | head -1 | sed 's/.*DNS Servers: *//')
  local primary_dns
  primary_dns=$(echo "$status_output" | grep "Current DNS Server:" | awk '{print $NF}')

  echo "  Interface: $link"
  echo "  Primary:   $primary_dns"
  echo "  All:       $current_dns"

  local ipv4_servers=""
  for ip in $current_dns; do
    if echo "$ip" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
      ipv4_servers="$ipv4_servers $ip"
    fi
  done
  ipv4_servers="${ipv4_servers# }"

  local suggested_dns=""
  local suggestion_msg=""
  if echo "$primary_dns" | grep -q ':'; then
    suggestion_msg="Primary DNS is IPv6 ($primary_dns). Adding explicit IPv4 DNS resolves this."
    if [[ -n "$ipv4_servers" ]]; then
      suggested_dns="$ipv4_servers"
      suggestion_msg+=" Detected IPv4 DNS: $suggested_dns"
    else
      suggested_dns="1.1.1.1 8.8.8.8"
      suggestion_msg+=" No IPv4 DNS detected. Use public resolvers as fallback."
    fi
  else
    suggestion_msg="DNS timeout. Restarting systemd-resolved may help first."
    suggested_dns="1.1.1.1 8.8.8.8"
  fi

  echo "  Diagnosis: $suggestion_msg"
  echo ""
  echo "  Fix: Add \"DNS=$suggested_dns\" to /etc/systemd/resolved.conf"
  echo ""
  read -p "  Apply? [y/N] " -r response
  echo ""

  if [[ "$response" =~ ^[Yy]$ ]]; then
    local dns_line="DNS=$suggested_dns"
    if grep -q "^DNS=" /etc/systemd/resolved.conf 2>/dev/null; then
      sed -i "s/^DNS=.*/$dns_line/" /etc/systemd/resolved.conf
    else
      echo "$dns_line" >> /etc/systemd/resolved.conf
    fi
    systemctl restart systemd-resolved 2>/dev/null || true
    echo "  Restarting systemd-resolved..."
    sleep 1
    if host cloud-images.ubuntu.com &>/dev/null 2>&1; then
      echo "  ✅ DNS resolution restored."
    else
      echo "  ❌ Still failing."
    fi
  else
    echo "  Skipped. Try: systemctl restart systemd-resolved"
  fi
}

# ── roundtable self-upgrade ────────────────────────────────────────
# Show version and repository info, or upgrade the tool itself.
#
# Examples:
#   roundtable status
#   roundtable upgrade
#   roundtable upgrade --version v2026-08-07.R0
#   roundtable upgrade list

roundtable_get_remote_url() {
  git -C "$ROOT" remote get-url origin 2>/dev/null || echo "unknown"
}

roundtable_get_latest_tag() {
  git -C "$ROOT" tag --list 'v*' --sort=-version:refname 2>/dev/null | head -1 || echo ""
}

cmd_roundtable_status() {
  local remote
  remote=$(roundtable_get_remote_url)

  echo "roundtable ${ROUNDTABLE_VERSION}"
  echo "  Branch:    ${ROUNDTABLE_BRANCH}"
  echo "  Remote:    ${remote}"

  if [[ "$ROUNDTABLE_BRANCH" == "main" ]]; then
    echo "  Latest:    unstable"
  else
    local latest
    latest=$(roundtable_get_latest_tag)
    if [[ -n "$latest" ]]; then
      if echo "${ROUNDTABLE_VERSION}" | grep -q "^${latest}"; then
        echo "  Latest:    ${latest} (up to date)"
      else
        echo "  Latest:    ${latest} (upgrade available)"
      fi
    fi
  fi
}

cmd_roundtable_upgrade() {
  local sub="${1:-}"

  if [[ "$sub" == "list" ]]; then
    echo "Fetching tags from origin..."
    git -C "$ROOT" fetch --tags origin 2>/dev/null || {
      echo "Error: Cannot reach remote. Check network." >&2
      exit 1
    }
    echo ""
    echo "Available versions:"
    local tags
    tags=$(git -C "$ROOT" tag --list 'v*' --sort=-version:refname 2>/dev/null)
    if [[ -z "$tags" ]]; then
      echo "  (no version tags found)"
    else
      local current_tag
      current_tag=$(echo "$ROUNDTABLE_VERSION" | grep -oP '^v\S+' || echo "")
      while IFS= read -r tag; do
        [[ -n "$tag" ]] || continue
        if [[ "$tag" == "$current_tag" ]]; then
          echo "  ${tag}   (current)"
        else
          echo "  ${tag}"
        fi
      done <<< "$tags"
    fi
    if [[ "$ROUNDTABLE_BRANCH" == "main" ]]; then
      echo ""
      echo "  You are on the unstable (main) branch."
      echo "  Run 'roundtable upgrade' to fast-forward to the latest commit."
      echo "  Use 'roundtable upgrade --version <tag>' to pin to a release."
    fi
    return 0
  fi

  local version=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --version)
        version="${2:-}"
        [[ -n "$version" ]] || { echo "Error: --version requires a value" >&2; exit 1; }
        shift 2
        ;;
      --version=*)
        version="${1#*=}"
        shift
        ;;
      -*)
        echo "Error: unknown flag $1" >&2; exit 1
        ;;
      *)
        echo "Usage: roundtable upgrade [--version TAG|unstable|main]" >&2
        exit 1
        ;;
    esac
  done

  # Fetch latest updates from remote
  echo "  Fetching updates..." >&2
  git -C "$ROOT" fetch --tags origin 2>/dev/null || {
    echo "Error: Cannot reach remote. Check network." >&2
    exit 1
  }

  # Resolve target
  local target=""
  if [[ -z "$version" ]]; then
    # Branch-aware default
    if [[ "$ROUNDTABLE_BRANCH" == "main" ]]; then
      git -C "$ROOT" fetch origin main 2>/dev/null || true
      target="origin/main"
    else
      target=$(roundtable_get_latest_tag)
      [[ -n "$target" ]] || { echo "Error: No version tags found on remote." >&2; exit 1; }
    fi
  else
    # Alias: unstable/main → origin/main
    if [[ "$version" == "unstable" ]] || [[ "$version" == "main" ]]; then
      target="origin/main"
    # Check if it is a tag
    elif git -C "$ROOT" tag -l "$version" 2>/dev/null | grep -qxF "$version"; then
      target="$version"
    elif git -C "$ROOT" branch -r 2>/dev/null | grep -q "origin/${version}$"; then
      target="origin/${version}"
    elif git -C "$ROOT" rev-parse --verify "$version" 2>/dev/null; then
      target="$version"
    else
      echo "Error: No tag or branch found: ${version}" >&2
      exit 1
    fi
  fi

  # Check if already on target
  local current_ref
  current_ref=$(git -C "$ROOT" rev-parse HEAD 2>/dev/null)
  local target_ref
  target_ref=$(git -C "$ROOT" rev-parse "$target" 2>/dev/null || echo "")

  if [[ -n "$target_ref" ]] && [[ "$current_ref" == "$target_ref" ]]; then
    echo "Already up to date." >&2
    return 0
  fi

  # Stash local changes if any
  if ! git -C "$ROOT" diff --quiet 2>/dev/null; then
    echo "  Stashing local changes..." >&2
    git -C "$ROOT" stash --include-untracked 2>/dev/null || true
    echo "  ⚠ Local changes stashed. Run 'git stash pop' after upgrade if needed." >&2
  fi

  # Perform upgrade
  if [[ "$target" == "origin/main" ]]; then
    echo "  Pushing forward on unstable branch..." >&2
    if git -C "$ROOT" merge --ff-only "$target" 2>&1; then
      echo "Upgraded to latest unstable." >&2
      echo "  Version: $(git -C "$ROOT" describe --tags --always 2>/dev/null)" >&2
    else
      echo "Error: Fast-forward merge failed. Try 'roundtable upgrade --version <tag>' to pin to a release." >&2
      exit 1
    fi
  else
    echo "  Upgrading to ${target}..." >&2
    if git -C "$ROOT" checkout "$target" 2>&1; then
      echo "Upgraded to ${target}." >&2
      echo "  Version: $(git -C "$ROOT" describe --tags --always 2>/dev/null)" >&2
    else
      echo "Error: Failed to checkout ${target}." >&2
      exit 1
    fi
  fi
}

# ── Main dispatch ────────────────────────────────────────────────
cmd="${1:-help}"; shift 2>/dev/null || true

case "$cmd" in
  wg)           cmd_wg "$@" ;;
  golden-image) cmd_golden_image "$@" ;;
  agent)        cmd_agent "$@" ;;
  proxy)        cmd_proxy "$@" ;;
  mcp)          cmd_mcp "$@" ;;
  check)        cmd_check "$@" ;;
  status)       cmd_roundtable_status ;;
  upgrade)      cmd_roundtable_upgrade "$@" ;;
  help|*)       usage ;;
esac
