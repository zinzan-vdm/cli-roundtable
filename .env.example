# cli-roundtable configuration
# Copy to .env and fill in your values

# WireGuard (required)
WG_HOST=vps-ip-or-domain
# Generate bcrypt hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(rounds=12)).decode())"
WG_PASSWORD_HASH=
# Plaintext password for script API calls (same password you bcrypted above)
WG_PASSWORD=

# Version pins (change to upgrade)
# wg-easy Docker image tag — pin to major version for stability
WG_EASY_VERSION=14
# Ubuntu LXD image alias for golden image base
UBUNTU_IMAGE=ubuntu:24.04

# Agent resource limits (LXD cgroup)
# 768MB/1vCPU per agent keeps the host stable while giving agents room
# for browser tasks (~500-700MB each). Bump to 1G on CX32+ (8GB host).
AGENT_MEMORY=768MB
AGENT_CPU=1
