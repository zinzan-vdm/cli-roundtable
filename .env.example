# cli-roundtable configuration
# Copy to .env and fill in your values

# WireGuard (required)
WG_HOST=vps-ip-or-domain

# WireGuard networking
# Each host gets a unique /24 subnet (e.g. Host A: 10.10.1.0/24, Host B: 10.20.1.0/24)
WG_SUBNET=10.10.1.0/24
# WireGuard tunnel port (public UDP)
WG_PORT=51820

# Cluster-wide network prefix that agents route through their host
# Default covers all 10.x.x.x subnets — change only if you need to avoid conflicts
CLUSTER_SUBNET=10.0.0.0/8

# WireGuard persistent keepalive for agent→host and cluster links (seconds)
WG_PERSISTENT_KEEPALIVE=25

# Ubuntu LXD image alias for golden image base
UBUNTU_IMAGE=ubuntu:24.04

# Agent resource limits (LXD cgroup)
# 768MB/1vCPU per agent keeps the host stable while giving agents room
# for browser tasks (~500-700MB each). Bump to 1G on CX32+ (8GB host).
AGENT_MEMORY=768MB
AGENT_CPU=1