# ── Roundtable Cluster Configuration ─────────────────────────
# Copy this file to .env and fill in your values.

# Required ──────────────────────────────────────────────────────
WG_HOST=<your-vps-ip-or-domain>
WG_PASSWORD=<choose-a-strong-password>

# Optional ─────────────────────────────────────────────────────
AGENT_MEMORY=1G                    # Default memory limit per agent
AGENT_CPU=1                        # Default CPU limit per agent